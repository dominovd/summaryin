# Tailor-to-job tool (/tailor-resume-summary/). Without AI_API_KEY the page shows "not switched on".
# Any OpenAI-compatible endpoint works. DeepSeek direct:
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# Same open model on a US host instead, e.g. OpenRouter:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-chat
AI_API_KEY=

# Limits per visitor (hashed IP) per day, and a global daily cap on AI calls
AI_WRITE_PER_DAY=5
AI_EXTRACT_PER_DAY=10
AI_GLOBAL_PER_DAY=1000
AI_LIMIT_SALT=change-me

# Upstash Redis (Vercel Marketplace). KV_REST_API_URL / KV_REST_API_TOKEN are read too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile. The site key is baked in at build time.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Chrome extension IDs allowed to send job postings to /tailor-resume-summary/?embed=1 (comma separated).
# Dev build: hlihnbichongccblnkcmbllleibhekdp. Add the Web Store ID after the first upload.
PUBLIC_EXTENSION_IDS=
# Chrome Web Store listing URL. Empty: /chrome-extension/ stays noindex and links to the site tool.
PUBLIC_CHROME_STORE_URL=
