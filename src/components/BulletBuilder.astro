---
/**
 * Resume bullet point builder with two modes.
 * Build: what you did + scale + method + result, verb suggested from the text.
 * Improve: paste a weak bullet; rules strip duty openers and pronouns, keep the
 * visitor's own verb and numbers, normalize frequency, and add [placeholders]
 * only for what is missing. Client-side only. The list is kept in localStorage.
 */
const VERB_GROUPS: [string, string[]][] = [
  ['Lead', ['Led', 'Managed', 'Supervised', 'Directed', 'Coordinated', 'Oversaw']],
  ['Build', ['Built', 'Created', 'Developed', 'Designed', 'Launched', 'Wrote']],
  ['Improve', ['Improved', 'Reduced', 'Increased', 'Streamlined', 'Cut', 'Raised']],
  ['Serve', ['Served', 'Supported', 'Assisted', 'Handled', 'Resolved', 'Trained']],
  ['Analyze', ['Analyzed', 'Tracked', 'Audited', 'Documented', 'Researched', 'Reported']],
];
const EXAMPLES = [
  'Responsible for answering customer emails and phone calls on a daily basis.',
  'I managed the store schedule for 12 employees',
  'Worked on inventory counts every week',
  'Helped customers with returns and exchanges',
];
---

<section class="bb card card-shadow" aria-label="Resume bullet point generator" data-bb>
  <div class="bb-modes" role="tablist" aria-label="Mode">
    <button type="button" role="tab" data-mode="build" aria-selected="true">Build from scratch</button>
    <button type="button" role="tab" data-mode="fix" aria-selected="false">Improve a bullet I have</button>
  </div>
  <div class="bb-grid">
    <div class="bb-input">
      <div class="bb-pane" data-pane="build">
        <label class="bb-label" for="bb-task">What did you do?</label>
        <input id="bb-task" class="bb-field" type="text" placeholder="e.g. customer emails and calls" autocomplete="off" />
        <span class="bb-label">Start with <span class="bb-opt">suggested from your text</span></span>
        <div class="bb-vsug" data-vsug="build"></div>
        <details class="bb-morev"><summary>More verbs (30)</summary>
          <div class="bb-vg">{VERB_GROUPS.map(([g, vs]) => (
            <div class="bb-vrow"><b>{g}</b>{vs.map((v) => <button type="button" data-verb={v} data-k="build">{v}</button>)}</div>
          ))}</div>
        </details>
        <label class="bb-label" for="bb-scale">How many or how often <span class="bb-opt">optional</span></label>
        <input id="bb-scale" class="bb-field" type="text" placeholder="e.g. 60+ per day" autocomplete="off" />
        <label class="bb-label" for="bb-method">How did you do it? <span class="bb-opt">optional</span></label>
        <input id="bb-method" class="bb-field" type="text" placeholder="e.g. by building reply templates" autocomplete="off" />
        <label class="bb-label" for="bb-result">What was the result? <span class="bb-opt">optional</span></label>
        <input id="bb-result" class="bb-field" type="text" placeholder="e.g. cutting average reply time by 30%" autocomplete="off" />
      </div>
      <div class="bb-pane" data-pane="fix" hidden>
        <label class="bb-label" for="bb-src">Paste a bullet from your resume</label>
        <textarea id="bb-src" class="bb-field bb-area" placeholder="e.g. Responsible for answering customer emails and phone calls on a daily basis."></textarea>
        <div class="bb-exrow"><span>Try one:</span>{EXAMPLES.map((x, i) => <button type="button" data-ex={i} data-text={x}>{x.replace(/\.$/, '').slice(0, 32)}…</button>)}</div>
        <span class="bb-label">Start it with <span class="bb-opt">suggested from your text</span></span>
        <div class="bb-vsug" data-vsug="fix"></div>
        <details class="bb-morev"><summary>More verbs (30)</summary>
          <div class="bb-vg">{VERB_GROUPS.map(([g, vs]) => (
            <div class="bb-vrow"><b>{g}</b>{vs.map((v) => <button type="button" data-verb={v} data-k="fix">{v}</button>)}</div>
          ))}</div>
        </details>
      </div>
      <div class="bb-toggles">
        <label class="bb-check"><input type="checkbox" data-o="cur" /> <span>Current job (present tense)</span></label>
        <label class="bb-check"><input type="checkbox" data-o="per" checked /> <span>End with a period</span></label>
        <label class="bb-check"><input type="checkbox" data-o="mk" checked /> <span>Bullet marker</span></label>
      </div>
      <p class="bb-privacy muted">Everything stays in your browser. Nothing is uploaded.</p>
    </div>

    <div class="bb-output">
      <div data-out="build"></div>
      <div data-out="fix" hidden></div>
      <div class="bb-list">
        <div class="bb-list-head"><h3>Your list</h3><span class="muted" data-count></span></div>
        <ul data-list></ul>
        <div class="bb-warn" data-warn hidden><span data-warn-text></span><span><button type="button" class="btn btn-ghost btn-sm" data-fill-now>Fill now</button> <button type="button" class="btn btn-ghost btn-sm" data-anyway>Copy anyway</button></span></div>
        <div class="bb-actions">
          <button type="button" class="btn btn-primary" data-copy-list><span data-copy-label>Copy list</span></button>
          <button type="button" class="btn btn-ghost" data-clear>Clear</button>
        </div>
        <div class="bb-next" data-next hidden>
          <b>✓ Copied.</b> <span>Next: the top of your resume. Write a 2 to 3 sentence summary that matches these bullets.</span>
          <a class="btn btn-primary btn-sm" href="/#generator">Resume summary generator →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bb { padding: 24px; }
  .bb-modes { display: inline-flex; gap: 4px; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 12px; padding: 4px; margin-bottom: 18px; }
  .bb-modes button { font: inherit; font-weight: 650; font-size: 0.95rem; border: 0; background: none; border-radius: 9px; padding: 8px 14px; color: var(--ink-soft); cursor: pointer; }
  .bb-modes button[aria-selected="true"] { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(0,0,0,.08); }
  .bb-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; }
  @media (max-width: 820px) { .bb { padding: 16px; } .bb-grid { grid-template-columns: 1fr; } .bb-modes { display: flex; } .bb-modes button { flex: 1; } }
  .bb-label { display: flex; justify-content: space-between; gap: 8px; font-weight: 650; font-size: 0.93rem; margin: 14px 0 7px; }
  .bb-label:first-child { margin-top: 0; }
  .bb-opt { font-weight: 450; color: var(--ink-muted); }
  .bb-field { width: 100%; font: inherit; padding: 11px 14px; border: 1px solid var(--border-strong); border-radius: var(--r-sm); color: var(--ink); background: #fff; }
  .bb-field:focus { outline: 2px solid var(--primary); outline-offset: 1px; border-color: var(--primary); }
  .bb-area { min-height: 84px; resize: vertical; line-height: 1.5; }
  .bb-vsug, .bb-vrow, .bb-exrow { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .bb-vsug :global(button), .bb-vrow button, .bb-exrow button { font: inherit; font-size: 0.9rem; border: 1px solid var(--border); background: #fff; color: var(--ink-soft); border-radius: 8px; padding: 6px 11px; cursor: pointer; }
  .bb-vsug :global(button[aria-pressed="true"]), .bb-vrow button[aria-pressed="true"] { background: var(--primary); border-color: var(--primary); color: #fff; }
  .bb-exrow { margin-top: 8px; font-size: 0.85rem; color: var(--ink-muted); }
  .bb-exrow button { font-size: 0.8rem; padding: 4px 9px; background: var(--bg-subtle); max-width: 100%; }
  .bb-morev { margin-top: 8px; }
  .bb-morev > summary { cursor: pointer; font-size: 0.88rem; font-weight: 650; color: var(--primary); list-style: none; }
  .bb-morev > summary::-webkit-details-marker { display: none; }
  .bb-vg { display: grid; gap: 6px; margin-top: 8px; }
  .bb-vrow b { width: 70px; font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-muted); }
  @media (max-width: 480px) { .bb-vrow b { width: 100%; } }
  .bb-toggles { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 16px; font-size: 0.92rem; color: var(--ink-soft); }
  .bb-check { display: inline-flex; gap: 6px; align-items: center; }
  .bb-check input { accent-color: var(--primary); width: 16px; height: 16px; }
  .bb-privacy { font-size: 0.85rem; margin: 12px 0 0; }
  .bb-output { background: var(--bg-subtle); border-radius: var(--r-md); padding: 16px; min-width: 0; }
  .bb-output :global(.bb-ver) { background: #fff; border: 1px solid var(--border); border-radius: var(--r-md); padding: 12px 14px; margin-bottom: 8px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; align-items: start; }
  .bb-output :global(.bb-ver small) { grid-column: 1 / -1; font-size: 0.72rem; font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
  .bb-output :global(.bb-ver p) { margin: 0; color: var(--ink); line-height: 1.55; }
  .bb-output :global(mark) { background: #fff3b8; border-bottom: 1px dashed #b58b00; border-radius: 3px; padding: 0 2px; color: inherit; }
  .bb-output :global(.bb-chk) { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .bb-output :global(.bb-chk span) { font-size: 0.78rem; font-weight: 650; border-radius: 999px; padding: 2px 9px; }
  .bb-output :global(.bb-chk .ok) { background: var(--success-soft); color: var(--success); }
  .bb-output :global(.bb-chk .no) { background: #fffbeb; color: #8a5a00; }
  .bb-output :global(.bb-empty) { background: #fff; border: 1px dashed var(--border-strong); border-radius: var(--r-md); padding: 18px; text-align: center; color: var(--ink-muted); font-size: 0.95rem; }
  .bb-output :global(.bb-empty p) { margin: 0 0 10px; }
  .bb-output :global(.bb-bad) { color: var(--ink-muted); text-decoration: line-through; text-decoration-color: #f87171; margin: 0 0 10px; }
  .bb-output :global(.bb-fixlist) { list-style: none; padding: 0; margin: 0 0 12px; display: grid; gap: 4px; font-size: 0.92rem; }
  .bb-output :global(.bb-fixlist .x) { color: #8a5a00; font-weight: 700; margin-right: 6px; }
  .bb-output :global(.bb-fixlist .v) { color: var(--success); font-weight: 700; margin-right: 6px; }
  .bb-output :global(.bb-note) { margin: 0 0 8px; font-size: 0.85rem; color: var(--ink-muted); }
  .bb-list { border-top: 1px solid var(--border); padding-top: 14px; margin-top: 8px; }
  .bb-list-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .bb-list-head h3 { margin: 0; font-size: 1rem; }
  .bb-list-head span { font-size: 0.85rem; }
  .bb-list ul { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 6px; }
  .bb-list :global(li) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 8px 10px; font-size: 0.95rem; color: var(--ink); line-height: 1.45; }
  .bb-list :global(li.empty) { display: block; color: var(--ink-muted); }
  .bb-list :global(.li-t) { outline: none; border-radius: 6px; }
  .bb-list :global(.li-t:focus) { background: var(--primary-soft); }
  .bb-list :global(.li-t mark) { background: #fff3b8; border-bottom: 1px dashed #b58b00; border-radius: 3px; padding: 0 2px; color: inherit; }
  .bb-list :global(.li-b) { display: flex; gap: 2px; }
  .bb-list :global(.li-b button) { border: 0; background: none; color: var(--ink-muted); font-size: 1rem; padding: 0 5px; cursor: pointer; }
  .bb-list :global(.li-b button:disabled) { opacity: 0.3; cursor: default; }
  .bb-warn { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; background: #fffbeb; border: 1px solid #fde68a; border-radius: var(--r-sm); padding: 8px 10px; font-size: 0.9rem; color: #8a5a00; font-weight: 650; }
  .bb-actions { display: flex; gap: 8px; margin-top: 10px; }
  .bb-actions .btn-primary { flex: 1; }
  .bb-next { margin-top: 12px; border: 1px solid #bfe3cc; background: var(--success-soft); border-radius: var(--r-md); padding: 12px 14px; font-size: 0.93rem; display: grid; gap: 8px; }
  .bb-next b { color: var(--success); }
  .bb-next .btn { justify-self: start; }
</style>

<script>
  import { track } from '@vercel/analytics';

  const root = document.querySelector<HTMLElement>('[data-bb]');
  if (root) {
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
    const VERBS = Array.from(root.querySelectorAll<HTMLElement>('[data-verb][data-k="build"]')).map((b) => b.dataset.verb!);
    const ALLV: Record<string, string> = Object.fromEntries(VERBS.map((v) => [v.toLowerCase(), v]));
    const PRES: Record<string, string> = { Led: 'Lead', Managed: 'Manage', Supervised: 'Supervise', Directed: 'Direct', Coordinated: 'Coordinate', Oversaw: 'Oversee', Built: 'Build', Created: 'Create', Developed: 'Develop', Designed: 'Design', Launched: 'Launch', Wrote: 'Write', Improved: 'Improve', Reduced: 'Reduce', Increased: 'Increase', Streamlined: 'Streamline', Cut: 'Cut', Raised: 'Raise', Served: 'Serve', Supported: 'Support', Assisted: 'Assist', Handled: 'Handle', Resolved: 'Resolve', Trained: 'Train', Analyzed: 'Analyze', Tracked: 'Track', Audited: 'Audit', Documented: 'Document', Researched: 'Research', Reported: 'Report' };
    const PRES_VALUES = new Set(Object.values(PRES));
    const KW: [RegExp, string[]][] = [
      [/email|call|phone|chat|ticket|customer|guest|patient|client|question|complaint|return|exchange|shopper|resident/i, ['Handled', 'Resolved', 'Supported', 'Assisted']],
      [/schedul|team|staff|employee|shift|crew|associate|new hire|volunteer/i, ['Managed', 'Coordinated', 'Supervised', 'Trained']],
      [/inventory|stock|count|order|shipment|record|report|data|log|audit|chart/i, ['Tracked', 'Audited', 'Documented', 'Managed']],
      [/process|workflow|system|wait|cost|error|turnaround/i, ['Improved', 'Streamlined', 'Reduced', 'Cut']],
      [/template|guide|program|menu|display|website|manual|training material|checklist/i, ['Built', 'Created', 'Designed', 'Developed']],
    ];
    const RV: Record<string, [string, string]> = { cutting: ['Cut', 'Cut'], reducing: ['Reduced', 'Reduce'], raising: ['Raised', 'Raise'], increasing: ['Increased', 'Increase'], improving: ['Improved', 'Improve'], saving: ['Saved', 'Save'], growing: ['Grew', 'Grow'], lowering: ['Lowered', 'Lower'], boosting: ['Boosted', 'Boost'], shortening: ['Shortened', 'Shorten'] };
    const KEY = 'summaryin_bullets';

    let mode: 'build' | 'fix' = 'build';
    let verbManual: string | null = null;
    let fixVerbManual: string | null = null;
    let versions: string[] = [];
    let fixText = '';
    let list: string[] = [];
    try { const v = JSON.parse(localStorage.getItem(KEY) || 'null'); if (Array.isArray(v)) list = v.filter((x) => typeof x === 'string'); } catch { /* storage unavailable */ }

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const M = (t: string) => `<mark>${esc(t)}</mark>`;
    const plain = (h: string) => { const d = document.createElement('div'); d.innerHTML = h; return d.textContent || ''; };
    const opt = (k: string) => ($(`[data-o="${k}"]`) as HTMLInputElement).checked;
    const tv = (v: string) => opt('cur') ? (PRES[v] ?? v) : v;
    const suggest = (text: string) => {
      const out: string[] = [];
      KW.forEach(([re, vs]) => { if (re.test(text)) vs.forEach((v) => { if (!out.includes(v)) out.push(v); }); });
      ['Handled', 'Managed', 'Supported', 'Improved', 'Built'].forEach((v) => { if (out.length < 5 && !out.includes(v)) out.push(v); });
      return out.slice(0, 5);
    };
    const fin = (s: string) => {
      s = s.replace(/\s+/g, ' ').replace(/\s+([,.])/g, '$1').trim().replace(/\.$/, '');
      return (opt('mk') ? '• ' : '') + s + (opt('per') ? '.' : '');
    };
    function checks(html: string): [boolean, string][] {
      const t = plain(html).replace(/^[•\-]\s*/, '');
      const first = t.split(' ')[0] || '';
      const weak = /^(responsible|duties|in charge|worked|helped|tasked|assisted with)\b/i.test(t);
      const verbOk = !weak && (!!ALLV[first.toLowerCase()] || PRES_VALUES.has(first) || (/ed$/.test(first) && !/^(i|my)$/i.test(first)));
      return [
        [verbOk, 'Action verb first'],
        [/\d/.test(t.replace(/\[[^\]]*\]/g, '')), 'Has a number'],
        [t.length <= 190, '1 to 2 lines'],
        [!/\b(I|me|my)\b/i.test(t), 'No I or my'],
      ];
    }
    const chk = (c: [boolean, string][]) => `<div class="bb-chk">${c.map(([ok, l]) => `<span class="${ok ? 'ok' : 'no'}">${ok ? '✓' : '✕'} ${l}</span>`).join('')}</div>`;
    function renderSug(kind: 'build' | 'fix', text: string, chosen: string) {
      let s = suggest(text); if (!s.includes(chosen)) s = [chosen, ...s.slice(0, 4)];
      $(`[data-vsug="${kind}"]`).innerHTML = s.map((v) => `<button type="button" data-verb="${v}" data-k="${kind}" aria-pressed="${v === chosen}">${tv(v)}</button>`).join('');
      root.querySelectorAll<HTMLElement>(`.bb-vrow [data-k="${kind}"]`).forEach((b) => { b.setAttribute('aria-pressed', String(b.dataset.verb === chosen)); b.textContent = tv(b.dataset.verb!); });
    }

    function build() {
      const task = ($('#bb-task') as HTMLInputElement).value.trim();
      const sc = ($('#bb-scale') as HTMLInputElement).value.trim();
      const how = ($('#bb-method') as HTMLInputElement).value.trim();
      const res = ($('#bb-result') as HTMLInputElement).value.trim().replace(/\.$/, '');
      const verb = verbManual ?? suggest(task)[0];
      renderSug('build', task, verb);
      const out = $('[data-out="build"]');
      if (!task) {
        out.innerHTML = '<div class="bb-empty"><p>Type what you did on the left. Versions appear here as you type.</p><button type="button" class="btn btn-ghost btn-sm" data-example>Show an example</button></div>';
        versions = []; return;
      }
      const v = tv(verb);
      const m = sc.match(/^([\d$][\d,.$%+kKmM]*\+?)\s*(.*)$/);
      const num = m ? m[1] : ''; const freq = m ? m[2] : sc;
      const hasNum = /\d/.test(task + ' ' + sc); const art = /^(the|a|an|our|their)\s/i.test(task);
      const obj = (num ? esc(num) + ' ' : (hasNum || art ? '' : M('[X]') + ' ')) + esc(task) + (freq ? ' ' + esc(freq) : '');
      const tail = res ? (/^\w+ing\s/i.test(res) ? ', ' + esc(res) : '; ' + esc(res)) : '';
      const resLead = () => { const mm = res.match(/^(\w+ing)\s+(.*)$/i); const k = mm?.[1].toLowerCase(); return k && RV[k] ? RV[k][opt('cur') ? 1 : 0] + ' ' + mm![2] : res.charAt(0).toUpperCase() + res.slice(1); };
      const vers: [string, string][] = [['Full', `${v} ${obj}${how ? ' ' + esc(how) : ''}${tail}`]];
      if (res) vers.push(['Result first', `${esc(resLead())}${how ? ' ' + esc(how) : ''} for ${obj}`]);
      if (res && how) vers.push(['Shorter', `${v} ${obj}${tail}`]);
      const seen = new Set<string>();
      const uniq = vers.filter(([, h]) => { const k = plain(h); if (seen.has(k)) return false; seen.add(k); return true; });
      out.innerHTML = (uniq.length === 1 ? '<p class="bb-note">Add a result to get a result-first version.</p>' : '') +
        uniq.map(([label, h], i) => { const t = fin(h); return `<div class="bb-ver"><small>${label}</small><p>${t}</p><button type="button" class="btn btn-ghost btn-sm" data-add="${i}">+ Add</button>${chk(checks(t))}</div>`; }).join('');
      versions = uniq.map(([, h]) => plain(fin(h)));
    }

    function fix() {
      const src = ($('#bb-src') as HTMLTextAreaElement).value.trim();
      const out = $('[data-out="fix"]');
      if (!src) { renderSug('fix', '', fixVerbManual ?? 'Handled'); out.innerHTML = '<div class="bb-empty"><p>Paste a bullet on the left, or try one of the examples. You will see what to fix and a stronger version.</p></div>'; fixText = ''; return; }
      const c = checks(esc(src));
      let s = src.replace(/^[•\-]\s*/, '').replace(/\.$/, '').trim();
      s = s.replace(/^(I|we)\s+/i, '').replace(/\bmy\s+/gi, 'the ');
      const weak = s.match(/^(responsible for|duties included|in charge of|helped( with| to)?|worked on|assisted with|tasked with)\s+/i);
      if (weak) s = s.slice(weak[0].length);
      s = s.replace(/^(\w+ing)\s+/i, (m0, g) => /^(training|bring|building)$/i.test(g) ? m0 : '');
      let freq = '';
      s = s.replace(/\s*\b(on a daily basis|every day|daily)\b/i, () => { freq = 'per day'; return ''; })
        .replace(/\s*\b(every week|weekly|on a weekly basis)\b/i, () => { freq = 'per week'; return ''; })
        .replace(/\s*\b(every month|monthly)\b/i, () => { freq = 'per month'; return ''; }).trim();
      const first = (s.split(' ')[0] || '').toLowerCase();
      let kept: string | null = null;
      if (!weak && (ALLV[first] || /ed$/.test(first))) { kept = ALLV[first] ?? first.charAt(0).toUpperCase() + first.slice(1); s = s.slice(first.length).trim(); }
      const verb = fixVerbManual ?? kept ?? suggest(s)[0];
      renderSug('fix', s, verb);
      const hasNum = /\d/.test(s);
      const hasRes = /%|\bby\s+\d|\b(cutting|reducing|raising|increasing|improving|saving)\b/i.test(s);
      const t = fin(`${tv(verb)} ${hasNum ? '' : M('[X]') + ' '}${esc(s)}${freq ? ' ' + freq : ''}${hasRes ? '' : ', ' + M('[result with a number]')}`);
      const msg: Record<string, string> = { 'Action verb first': 'Starts with a duty or a pronoun, not an action verb', 'Has a number': 'No number: add volume or a result', '1 to 2 lines': 'Too long: split it into two bullets', 'No I or my': 'Remove I, me, and my' };
      const notes = c.map(([ok, l]) => `<li><span class="${ok ? 'v' : 'x'}">${ok ? '✓' : '✕'}</span>${ok ? l : msg[l]}</li>`);
      if (kept && !fixVerbManual) notes.push(`<li><span class="v">✓</span>Kept your verb "${esc(kept)}"</li>`);
      if (freq) notes.push(`<li><span class="v">✓</span>"${freq}" instead of a vague time phrase</li>`);
      out.innerHTML = `<p class="bb-bad">${esc(src)}</p><ul class="bb-fixlist">${notes.join('')}</ul><div class="bb-ver"><small>Stronger version${/<mark>/.test(t) ? ' · fill the yellow parts' : ''}</small><p>${t}</p><button type="button" class="btn btn-ghost btn-sm" data-add-fix>+ Add</button>${chk(checks(t))}</div>`;
      fixText = plain(t);
    }

    function renderList() {
      const ul = $('[data-list]');
      ul.innerHTML = list.length
        ? list.map((b, i) => `<li><span class="li-t" contenteditable="true" spellcheck="false" data-i="${i}">${esc(b).replace(/\[([^\]]+)\]/g, '<mark>[$1]</mark>')}</span><span class="li-b"><button type="button" data-up="${i}" aria-label="Move up"${i === 0 ? ' disabled' : ''}>↑</button><button type="button" data-dn="${i}" aria-label="Move down"${i === list.length - 1 ? ' disabled' : ''}>↓</button><button type="button" data-del="${i}" aria-label="Remove">×</button></span></li>`).join('')
        : '<li class="empty">Press Add on a version to start your list.</li>';
      const n = list.length;
      $('[data-count]').textContent = `${n} bullet${n === 1 ? '' : 's'} · ${n < 4 ? 'aim for 4 to 6 on your current role' : n <= 6 ? '✓ good length for your current role' : 'more than 6: keep the strongest'}`;
      $('[data-warn]').hidden = true; $('[data-next]').hidden = true;
      try { localStorage.setItem(KEY, JSON.stringify(list)); } catch { /* storage unavailable */ }
    }
    const save = () => { try { localStorage.setItem(KEY, JSON.stringify(list)); } catch { /* storage unavailable */ } };

    async function copyList(withPlaceholders: boolean) {
      const t = list.join('\n');
      try { await navigator.clipboard.writeText(t); } catch { /* clipboard unavailable */ }
      $('[data-warn]').hidden = true; $('[data-next]').hidden = false;
      const l = $('[data-copy-label]'); l.textContent = 'Copied!'; setTimeout(() => { l.textContent = 'Copy list'; }, 1600);
      track(withPlaceholders ? 'copy_with_placeholders' : 'copy', { tool: 'bullets', count: list.length });
    }

    root.addEventListener('input', (e) => {
      const t = e.target as HTMLElement;
      const li = t.closest<HTMLElement>('.li-t');
      if (li) { list[Number(li.dataset.i)] = li.textContent || ''; save(); return; }
      if (t.closest('[data-pane="fix"]')) fix(); else if (t.closest('[data-pane="build"]')) build();
    });
    root.addEventListener('change', (e) => { if ((e.target as HTMLElement).dataset.o) { build(); fix(); } });
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const m = t.closest<HTMLElement>('.bb-modes [data-mode]');
      if (m) {
        mode = m.dataset.mode as typeof mode;
        root.querySelectorAll('.bb-modes button').forEach((b) => b.setAttribute('aria-selected', String(b === m)));
        root.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => { p.hidden = p.dataset.pane !== mode; });
        root.querySelectorAll<HTMLElement>('[data-out]').forEach((p) => { p.hidden = p.dataset.out !== mode; });
        track('bullet_mode', { mode }); return;
      }
      const vb = t.closest<HTMLElement>('[data-verb]');
      if (vb) { if (vb.dataset.k === 'fix') { fixVerbManual = vb.dataset.verb!; fix(); } else { verbManual = vb.dataset.verb!; build(); } return; }
      if (t.closest('[data-example]')) {
        ($('#bb-task') as HTMLInputElement).value = 'customer emails and calls';
        ($('#bb-scale') as HTMLInputElement).value = '60+ per day';
        ($('#bb-method') as HTMLInputElement).value = 'by building reply templates';
        ($('#bb-result') as HTMLInputElement).value = 'cutting average reply time by 30%';
        verbManual = null; build(); return;
      }
      const ex = t.closest<HTMLElement>('[data-ex]');
      if (ex) { ($('#bb-src') as HTMLTextAreaElement).value = ex.dataset.text!; fixVerbManual = null; fix(); return; }
      const add = t.closest<HTMLElement>('[data-add]');
      if (add) { list.push(versions[Number(add.dataset.add)]); renderList(); track('bullet_add', { source: 'build' }); return; }
      if (t.closest('[data-add-fix]')) { list.push(fixText); renderList(); track('bullet_add', { source: 'fix' }); return; }
      const up = t.closest<HTMLElement>('[data-up]'); if (up) { const i = Number(up.dataset.up); [list[i - 1], list[i]] = [list[i], list[i - 1]]; renderList(); return; }
      const dn = t.closest<HTMLElement>('[data-dn]'); if (dn) { const i = Number(dn.dataset.dn); [list[i + 1], list[i]] = [list[i], list[i + 1]]; renderList(); return; }
      const del = t.closest<HTMLElement>('[data-del]'); if (del) { list.splice(Number(del.dataset.del), 1); renderList(); return; }
      if (t.closest('[data-clear]')) { list = []; renderList(); return; }
      if (t.closest('[data-copy-list]')) {
        const n = list.filter((b) => /\[[^\]]*\]/.test(b)).length;
        if (!list.length) return;
        if (n) { $('[data-warn-text]').textContent = `${n} bullet${n > 1 ? 's' : ''} still ${n > 1 ? 'have' : 'has'} [brackets].`; $('[data-warn]').hidden = false; $('[data-next]').hidden = true; return; }
        copyList(false); return;
      }
      if (t.closest('[data-anyway]')) { copyList(true); return; }
      if (t.closest('[data-fill-now]')) {
        $('[data-warn]').hidden = true;
        const mk = root.querySelector<HTMLElement>('[data-list] mark');
        if (mk) { const li = mk.closest<HTMLElement>('.li-t')!; li.focus(); const r = document.createRange(); r.selectNodeContents(mk); const s = getSelection()!; s.removeAllRanges(); s.addRange(r); }
      }
    });

    build(); fix(); renderList();
  }
</script>
