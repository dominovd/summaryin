---
/**
 * Email capture with the PDF lead magnet.
 * Set SITE.emailFormAction (Formspree/Buttondown/ConvertKit) to make it live.
 */
import { SITE } from '../data/site';

interface Props {
  /** Personalizes the promise, e.g. "customer service". */
  professionLabel?: string;
}
const { professionLabel } = Astro.props;
const promise = professionLabel
  ? `50 ready-to-use ${professionLabel} summaries (PDF)`
  : SITE.leadMagnet;
---

<section class="section" aria-labelledby="email-heading">
  <div class="container">
    <div class="email-card card card-shadow">
      <div class="email-copy">
        <span class="email-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <rect x="2.5" y="5" width="19" height="14" rx="2.5" stroke="currentColor" stroke-width="1.8"/>
            <path d="M3.5 7l8.5 6 8.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <div>
          <h2 id="email-heading">Need a few more ideas?</h2>
          <p class="muted">Get {promise} as a free download in your inbox. One useful email, no spam.</p>
        </div>
      </div>
      <form
        class="email-form"
        method="POST"
        action={SITE.emailFormAction || undefined}
        data-email-form
        data-live={SITE.emailFormAction ? 'true' : 'false'}
      >
        <label class="visually-hidden" for="email-input">Email address</label>
        <input
          id="email-input"
          class="email-input"
          type="email"
          name="email"
          placeholder="you@example.com"
          required
        />
        <button type="submit" class="btn btn-primary">Send me the PDF</button>
      </form>
    </div>
  </div>
</section>

<style>
  .email-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: center;
    padding: 28px 32px;
  }
  @media (max-width: 820px) {
    .email-card { grid-template-columns: 1fr; }
  }
  .email-copy { display: flex; gap: 16px; align-items: flex-start; }
  .email-copy h2 { font-size: 1.25rem; margin-bottom: 4px; }
  .email-copy p { margin: 0; font-size: 0.97rem; max-width: 44ch; }
  .email-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-md);
    background: var(--primary-soft);
    color: var(--primary);
    flex: none;
  }
  .email-form { display: flex; gap: 10px; flex-wrap: wrap; }
  .email-input {
    font: inherit;
    padding: 11px 14px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    min-width: 230px;
  }
  .email-input:focus { outline: 2px solid var(--primary); outline-offset: 1px; border-color: var(--primary); }
</style>

<script>
  // Until an endpoint is configured, prevent a broken POST and show a friendly note.
  const form = document.querySelector<HTMLFormElement>('[data-email-form]');
  if (form && form.dataset.live !== 'true') {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = form.querySelector('button')!;
      btn.textContent = 'Coming soon!';
      setTimeout(() => (btn.textContent = 'Send me the PDF'), 2000);
    });
  }
</script>
