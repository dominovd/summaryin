---
/**
 * Client-side summary generator. Local data only, no API calls.
 * The role field is matched against the shared role list (synonyms included),
 * so skills, audience, credential and next-step links follow the role.
 * Numbers are never invented: tenure and results stay as [X] placeholders
 * until the visitor types them.
 */
import { ROLES } from '../data/roles';
import { SITE } from '../data/site';

interface Props {
  /** Prefilled role. Empty on the homepage, where an example is shown until the visitor types. */
  defaultRole?: string;
  /** Role used for the example state when the field is empty. */
  exampleRole?: string;
  /** Heading level text above the form. */
  heading?: string;
  /** Preselected experience level. */
  defaultLevel?: 'entry' | 'mid' | 'senior';
  /** Preselected output tab. */
  defaultMode?: 'summary' | 'objective' | 'linkedin';
}

const {
  defaultRole = '',
  exampleRole = 'Customer Service Representative',
  heading = 'Tell us about your experience',
  defaultLevel = 'mid',
  defaultMode = 'summary',
} = Astro.props;
const LEVELS = [['entry', 'Entry level'], ['mid', 'Mid-level'], ['senior', 'Senior']] as const;
const MODES = [['summary', 'Summary'], ['objective', 'Objective'], ['linkedin', 'LinkedIn headline']] as const;

const data = {
  roles: ROLES.map((r) => ({
    slug: r.slug, name: r.name, synonyms: r.synonyms, skills: r.skills,
    audience: r.audience, credential: r.credential, family: r.family, pages: r.pages,
  })),
  generic: ['Communication', 'Teamwork', 'Problem solving', 'Time management', 'Organization', 'Attention to detail'],
  closing: {
    healthcare: ['Keeps documentation accurate and handoffs clear on busy shifts.', 'Trusted to handle a full assignment and flag changes early.', 'Patients and families get calm, clear explanations at every step.'],
    hospitality: ['Keeps orders accurate and service moving during peak hours.', 'Comfortable running a full section on the busiest nights.', 'Guests leave with a good experience, even when the room is packed.'],
    'customer-office': ['Keeps records organized and follows every request through to the end.', 'Trusted to handle the requests other people escalate.', 'People know they will get a clear, friendly answer.'],
    business: ['Keeps work organized, documented, and on schedule.', 'Owns outcomes from planning to delivery.', 'Builds steady working relationships with every team involved.'],
    'operations-safety': ['Follows procedures closely and keeps reports accurate.', 'Stays steady and decisive when something goes wrong.', 'Known as a reliable teammate on every shift.'],
    education: ['Plans clear lessons and tracks progress for every learner.', 'Comfortable managing a full group and adjusting plans on the spot.', 'Builds a calm, encouraging space where learners speak up.'],
    nanny: ['Keeps daily routines steady and parents informed.', 'Trusted to run the household schedule on busy days.', 'Children feel safe, and parents get a clear update every day.'],
    caregiver: ['Keeps care routines and medication schedules on track.', 'Trusted to notice changes early and act on them.', 'Clients and families get patient, respectful support.'],
  },
  pdf: Boolean(SITE.emailFormAction),
};
---

<section class="gen card card-shadow" aria-label="Resume summary generator" data-generator data-example-role={exampleRole}>
  <script type="application/json" data-gen-data set:html={JSON.stringify(data)} />
  <div class="gen-grid">
    <div class="gen-input">
      <h2 class="gen-title">{heading}</h2>

      <label class="gen-label" for="gen-role">Role <span class="gen-note">type or pick</span></label>
      <input id="gen-role" class="gen-field" type="text" value={defaultRole} placeholder={`e.g. ${exampleRole}`} autocomplete="off" />
      <div class="gen-sug" data-sug>
        {['Registered Nurse', 'CNA', 'Customer Service', 'Retail', 'Sales'].map((r) => (
          <button type="button" class="gen-sug-btn" data-role={r}>{r}</button>
        ))}
      </div>
      <p class="gen-hint" data-role-hint aria-live="polite"></p>

      <span class="gen-label" id="gen-level-label">Experience</span>
      <div class="seg gen-seg" role="group" aria-labelledby="gen-level-label" data-level>
        {LEVELS.map(([v, l]) => <button type="button" data-value={v} aria-pressed={v === defaultLevel ? 'true' : 'false'}>{l}</button>)}
      </div>

      <span class="gen-label" id="gen-skills-label">Skills <span class="gen-note">pick up to 3</span></span>
      <div class="gen-chips" role="group" aria-labelledby="gen-skills-label" data-skills></div>

      <details class="gen-more" data-more>
        <summary>+ More details: years, one result, tone</summary>
        <div class="gen-two">
          <div>
            <label class="gen-label" for="gen-years">Years <span class="gen-note">optional</span></label>
            <input id="gen-years" class="gen-field" type="text" inputmode="numeric" placeholder="e.g. 4" autocomplete="off" />
          </div>
          <div>
            <label class="gen-label" for="gen-result">One result you're proud of <span class="gen-note">optional</span></label>
            <input id="gen-result" class="gen-field" type="text" placeholder="e.g. Cut wait times by 20%" autocomplete="off" />
          </div>
        </div>
        <span class="gen-label" id="gen-tone-label">Tone</span>
        <div class="seg gen-seg" role="group" aria-labelledby="gen-tone-label" data-tone>
          <button type="button" data-value="0" aria-pressed="true">Professional</button>
          <button type="button" data-value="1" aria-pressed="false">Confident</button>
          <button type="button" data-value="2" aria-pressed="false">Friendly</button>
        </div>
      </details>

      <p class="gen-privacy muted">
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <rect x="2.5" y="6" width="9" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
          <path d="M4.5 6V4.5a2.5 2.5 0 0 1 5 0V6" stroke="currentColor" stroke-width="1.6"/>
        </svg>
        Nothing you type leaves this device.
      </p>
    </div>

    <div class="gen-output">
      <div class="gen-tabs" role="tablist" aria-label="Format" data-tabs>
        {MODES.map(([v, l]) => <button type="button" role="tab" data-mode={v} aria-selected={v === defaultMode ? 'true' : 'false'}>{l}</button>)}
      </div>
      <p class="gen-example" data-example-label hidden></p>
      <div class="gen-result" data-result contenteditable="true" spellcheck="false" aria-live="polite" aria-label="Your summary, editable"></div>
      <div class="gen-meta" data-meta></div>
      <div class="gen-warn" data-warn hidden>
        <span data-warn-text></span>
        <span class="gen-warn-actions">
          <button type="button" class="btn btn-ghost btn-sm" data-fill-now>Fill now</button>
          <button type="button" class="btn btn-ghost btn-sm" data-copy-anyway>Copy anyway</button>
        </span>
      </div>
      <div class="gen-actions">
        <button type="button" class="btn btn-primary" data-copy>
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.7"/>
            <path d="M10.5 5.5v-2A1.5 1.5 0 0 0 9 2H4a1.5 1.5 0 0 0-1.5 1.5v5A1.5 1.5 0 0 0 4 10h1.5" stroke="currentColor" stroke-width="1.7"/>
          </svg>
          <span data-copy-label>Copy</span>
        </button>
        <button type="button" class="btn btn-ghost" data-next>Another version</button>
      </div>
      <p class="gen-tip muted" data-tip>Yellow parts are placeholders. Click one to replace it with a true detail. You can edit the whole text.</p>
      <div class="gen-after" data-after hidden></div>
    </div>
  </div>
</section>

<style>
  .gen { padding: 28px; }
  .gen-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 32px; }
  @media (max-width: 820px) { .gen { padding: 18px; } .gen-grid { grid-template-columns: 1fr; gap: 20px; } }
  .gen-title { font-size: 1.15rem; margin-bottom: 4px; }
  .gen-label { display: flex; justify-content: space-between; gap: 8px; font-weight: 650; font-size: 0.93rem; margin: 16px 0 7px; }
  .gen-note { font-weight: 450; color: var(--ink-muted); }
  .gen-field { width: 100%; font: inherit; padding: 11px 14px; border: 1px solid var(--border-strong); border-radius: var(--r-sm); color: var(--ink); background: #fff; }
  .gen-field:focus { outline: 2px solid var(--primary); outline-offset: 1px; border-color: var(--primary); }
  .gen-sug { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .gen-sug-btn { font: inherit; font-size: 0.85rem; border: 1px solid var(--border); background: var(--bg-subtle); color: var(--ink-soft); border-radius: 999px; padding: 4px 11px; cursor: pointer; }
  .gen-sug-btn[aria-pressed="true"] { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); font-weight: 650; }
  .gen-hint { font-size: 0.84rem; color: var(--ink-muted); margin: 7px 0 0; min-height: 1.2em; }
  .gen-hint :global(a) { font-weight: 650; }
  .gen-seg { display: flex; width: 100%; }
  .gen-seg button { flex: 1; padding: 8px 6px; }
  .gen-chips { display: flex; flex-wrap: wrap; gap: 7px; }
  .gen-chips :global(.chip) { font-size: 0.88rem; padding: 6px 12px; }
  .gen-chips :global(.chip[aria-pressed="true"])::before { content: "✓ "; }
  .gen-more { margin-top: 16px; border-top: 1px solid var(--border); }
  .gen-more > summary { list-style: none; cursor: pointer; padding-top: 12px; font-weight: 650; color: var(--primary); font-size: 0.93rem; }
  .gen-more > summary::-webkit-details-marker { display: none; }
  .gen-more[open] > summary { display: none; }
  .gen-more[open] { border-top: 0; margin-top: 0; }
  .gen-two { display: grid; grid-template-columns: 110px 1fr; gap: 10px; }
  @media (max-width: 480px) { .gen-two { grid-template-columns: 1fr; } }
  .gen-privacy { display: flex; align-items: center; gap: 6px; font-size: 0.87rem; margin: 14px 0 0; justify-content: center; }

  .gen-output { display: flex; flex-direction: column; min-width: 0; }
  .gen-tabs { display: flex; flex-wrap: wrap; gap: 6px; }
  .gen-tabs button { font: inherit; font-size: 0.88rem; border: 1px solid var(--border); background: #fff; color: var(--ink-soft); border-radius: 999px; padding: 6px 13px; cursor: pointer; }
  .gen-tabs button[aria-selected="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .gen-example { margin: 12px 0 -4px; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-muted); }
  .gen-result { background: #fff; border: 1px solid var(--border); border-radius: var(--r-md); padding: 18px 20px; margin: 12px 0 0; min-height: 150px; color: var(--ink); font-size: 1.02rem; line-height: 1.65; outline: none; }
  .gen-result:focus { border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-soft); }
  .gen-result.is-example { color: var(--ink-muted); }
  .gen-result :global(mark) { background: #fff3b8; border-bottom: 1px dashed #b58b00; border-radius: 3px; padding: 0 2px; color: inherit; cursor: text; }
  .gen-result :global(mark.is-done) { background: var(--success-soft); border-bottom-color: var(--success); }
  .gen-meta { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 8px; font-size: 0.84rem; color: var(--ink-muted); }
  .gen-meta :global(.ok) { color: var(--success); font-weight: 650; }
  .gen-meta :global(.warn) { color: #8a5a00; font-weight: 650; }
  .gen-warn { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; background: #fffbeb; border: 1px solid #fde68a; border-radius: var(--r-sm); padding: 8px 10px; font-size: 0.9rem; color: #8a5a00; font-weight: 650; }
  .gen-warn-actions { display: flex; gap: 6px; }
  .btn-sm { padding: 6px 12px; font-size: 0.88rem; }
  .gen-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
  .gen-actions .btn-primary { flex: 1; min-width: 150px; }
  .gen-tip { font-size: 0.84rem; margin: 12px 0 0; }
  .gen-after { margin-top: 14px; border: 1px solid #bfe3cc; background: var(--success-soft); border-radius: var(--r-md); padding: 14px 16px; font-size: 0.95rem; }
  .gen-after :global(b) { color: var(--ink); }
  .gen-after :global(p) { margin: 4px 0 10px; color: var(--ink-soft); }
</style>

<script>
  import { track } from '@vercel/analytics';

  type Role = { slug: string; name: string; synonyms: string[]; skills: string[]; audience: string; credential: string; family: string; pages: { s: boolean; d: boolean; n: boolean } };
  type Data = { roles: Role[]; generic: string[]; closing: Record<string, string[]>; pdf: boolean };

  document.querySelectorAll<HTMLElement>('[data-generator]').forEach((root) => {
    const data: Data = JSON.parse(root.querySelector('[data-gen-data]')!.textContent || '{}');
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
    const roleInput = $<HTMLInputElement>('#gen-role');
    const yearsInput = $<HTMLInputElement>('#gen-years');
    const resultInput = $<HTMLInputElement>('#gen-result');
    const result = $('[data-result]');
    const meta = $('[data-meta]');
    const warn = $('[data-warn]');
    const after = $('[data-after]');
    const exampleLabel = $('[data-example-label]');
    const hint = $('[data-role-hint]');
    const skillsBox = $('[data-skills]');
    const more = $<HTMLDetailsElement>('[data-more]');
    const exampleRole = root.dataset.exampleRole || 'Customer Service Representative';

    if (window.matchMedia('(min-width: 821px)').matches) more.open = true;

    let mode = (root.querySelector<HTMLElement>('[data-tabs] [aria-selected="true"]')?.dataset.mode ?? 'summary') as 'summary' | 'objective' | 'linkedin';
    let version = 0;
    let selected: string[] = [];
    let selectedFor = '';

    const ACR = ['cna', 'rn', 'lpn', 'cdl', 'hr', 'csr', 'sdr', 'bdr', 'it', 'pm', 'cpa', 'stna'];
    const disp = (r: string) => r !== r.toLowerCase() ? r : r.split(' ').map((w) => ACR.includes(w) ? w.toUpperCase() : w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const M = (t: string) => `<mark>${esc(t)}</mark>`;
    const lc = (s: string) => /^[A-Z0-9]{2,}|^[A-Z][a-z]*[A-Z]/.test(s.split(' ')[0]) ? s : s.charAt(0).toLowerCase() + s.slice(1);
    const list = (a: string[]) => { const x = a.filter(Boolean).map(lc); return x.length > 1 ? x.slice(0, -1).join(', ') + ' and ' + x[x.length - 1] : x.join(''); };
    const seg = (sel: string) => $(sel).querySelector<HTMLElement>('[aria-pressed="true"]')?.dataset.value ?? '';

    function matchRole(input: string): Role | null {
      const q = input.toLowerCase().trim();
      if (!q) return null;
      let best: Role | null = null, score = 0;
      for (const r of data.roles) for (const c of [r.name.toLowerCase(), ...r.synonyms]) {
        const s = q === c ? 100 + c.length : c.length >= 3 && q.includes(c) ? c.length : 0;
        if (s > score) { score = s; best = r; }
      }
      return best;
    }

    const typed = () => roleInput.value.trim();
    const roleText = () => disp(typed() || exampleRole);
    const role = () => matchRole(typed() || exampleRole);

    function renderSkills() {
      const r = role();
      const pool = r && r.skills.length ? r.skills : data.generic;
      const key = r ? r.slug : '_generic';
      if (selectedFor !== key) { selected = pool.slice(0, 3); selectedFor = key; }
      skillsBox.innerHTML = pool.map((s) => `<button type="button" class="chip" aria-pressed="${selected.includes(s)}">${esc(s)}</button>`).join('');
      const links: string[] = [];
      if (r) {
        if (r.pages.s) links.push(`<a href="/resume-summary/${r.slug}/">20 ${esc(r.name)} examples</a>`);
        if (r.pages.d) links.push(`<a href="/job-description/${r.slug}/">${esc(r.name)} duties</a>`);
        if (r.pages.n) links.push(`<a href="/no-experience/${r.slug}/">No experience</a>`);
      }
      hint.innerHTML = !typed() ? '' : r ? `Matched to <b>${esc(r.name)}</b>.${links.length ? ' See: ' + links.join(' · ') : ''}` : 'No examples for this role yet, so general skills are shown.';
      root.querySelectorAll<HTMLButtonElement>('.gen-sug-btn').forEach((b) => b.setAttribute('aria-pressed', String(matchRole(b.dataset.role!)?.slug === r?.slug && !!typed())));
      root.dispatchEvent(new CustomEvent('summaryin:role', { bubbles: true, detail: typed() && r ? { slug: r.slug, name: r.name, pages: r.pages } : { slug: null } }));
    }

    function build(): string {
      const r = role();
      const lvl = seg('[data-level]') as 'entry' | 'mid' | 'senior';
      const tone = Number(seg('[data-tone]') || 0);
      const rt = roleText();
      const s = selected.length ? selected : (r?.skills ?? data.generic).slice(0, 3);
      const yrs = yearsInput.value.trim().replace(/\s*years?$/i, '');
      const res = resultInput.value.trim().replace(/\.$/, '');
      const Y = yrs ? esc(yrs) : M('[X]');
      const yw = yrs === '1' ? 'year' : 'years';
      const R = res ? esc(res.charAt(0).toUpperCase() + res.slice(1)) : M(lvl === 'entry' ? '[One result, project, or credential]' : '[One result with a number]');
      const aud = r ? esc(r.audience) : M('[the people you serve]');
      const closing = (data.closing[r?.slug ?? ''] ?? data.closing[r?.family ?? 'business'] ?? data.closing.business)[tone];
      const head = (lvl === 'senior' && !/senior|lead|manager|director|head|supervisor|chief/i.test(rt) ? 'Senior ' + lc(rt) : rt);
      const fit = (t: string) => (t + ' ' + closing).replace(/<[^>]+>/g, '').split(/\s+/).length <= 60 ? t + ' ' + esc(closing) : t;

      if (mode === 'linkedin') return `${esc(rt)} | ${s.map(esc).join(' · ')} | ${lvl === 'entry' ? 'Entry level' : Y + '+ years'}`;
      if (mode === 'objective') {
        if (lvl === 'entry') {
          const cred = r?.credential ? esc(r.credential) : M('[a relevant course or certification]');
          return `Entry-level ${esc(rt)} with ${cred}, seeking a position at ${M('[Company]')} to apply ${esc(list(s.slice(0, 2)))} in work with ${aud}.`;
        }
        return `${esc(head)} with ${Y} ${yw} of experience, seeking a position at ${M('[Company]')} to bring ${esc(list(s.slice(0, 2)))} to ${aud}. ${R}.`;
      }
      if (lvl === 'entry') {
        const v = [
          `${esc(rt)} with training and hands-on experience in ${esc(list(s.slice(0, 2)))}. ${R}. Ready to work with ${aud} and to keep building skills in ${esc(lc(s[2] ?? 'clear communication'))}.`,
          `Entry-level ${esc(rt)} skilled in ${esc(list(s))}. ${R}. Ready to learn fast and support ${aud} from the first shift.`,
          `Entry-level ${esc(rt)} with practical experience in ${esc(list(s.slice(0, 2)))}. ${R}.`,
        ];
        return version < 2 ? fit(v[version]) : v[2];
      }
      const v = [
        `${esc(head)} with ${Y} ${yw} of experience in ${esc(list(s.slice(0, 2)))}, working with ${aud}. ${R}. Also skilled in ${esc(lc(s[2] ?? 'clear communication'))}.`,
        `${esc(head)} skilled in ${esc(list(s))}, with ${Y} ${yw} of experience working with ${aud}. ${R}.`,
        `${esc(head)} with ${Y} ${yw} in ${esc(list(s.slice(0, 2)))}. ${R}.`,
      ];
      return version < 2 ? fit(v[version]) : v[2];
    }

    function updateMeta() {
      const text = result.textContent || '';
      const words = text.split(/\s+/).filter(Boolean).length;
      const open = (text.match(/\[[^\]]*\]/g) || []).length;
      result.querySelectorAll('mark').forEach((m) => m.classList.toggle('is-done', !/\[/.test(m.textContent || '')));
      const parts: string[] = [];
      if (mode === 'linkedin') parts.push(`<span class="${text.length <= 220 ? 'ok' : 'warn'}">${text.length} / 220 characters</span>`);
      else if (mode === 'objective') parts.push(`<span class="${words >= 20 && words <= 45 ? 'ok' : 'warn'}">${words} words</span><span>Target for an objective: 20 to 45</span>`);
      else parts.push(`<span class="${words >= 40 && words <= 60 ? 'ok' : version === 2 ? '' : 'warn'}">${words} words</span><span>${version === 2 ? 'Short version' : 'Target for a resume: 40 to 60'}</span>`);
      parts.push(open ? `<span class="warn">${open} detail${open > 1 ? 's' : ''} to fill in</span>` : '<span class="ok">✓ No placeholders</span>');
      meta.innerHTML = parts.join('');
      if (!open) warn.hidden = true;
    }

    function render() {
      const isExample = !typed();
      result.innerHTML = build();
      result.classList.toggle('is-example', isExample);
      exampleLabel.hidden = !isExample;
      exampleLabel.textContent = `Example for ${roleText()}. Type your role to make it yours.`;
      warn.hidden = true;
      after.hidden = true;
      $('[data-next]').hidden = mode !== 'summary';
      updateMeta();
    }

    function full() { renderSkills(); render(); }

    roleInput.addEventListener('input', () => { version = 0; full(); });
    yearsInput.addEventListener('input', render);
    resultInput.addEventListener('input', render);
    result.addEventListener('input', updateMeta);
    result.addEventListener('click', (e) => {
      const m = (e.target as HTMLElement).closest('mark');
      if (m && /^\[/.test(m.textContent || '')) { const r = document.createRange(); r.selectNodeContents(m); const s = getSelection()!; s.removeAllRanges(); s.addRange(r); }
    });

    root.querySelectorAll<HTMLElement>('[data-level], [data-tone]').forEach((g) => g.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }));
    skillsBox.addEventListener('click', (e) => {
      const c = (e.target as HTMLElement).closest('.chip'); if (!c) return;
      const name = c.textContent!.trim(); const i = selected.indexOf(name);
      if (i >= 0) { if (selected.length > 1) selected.splice(i, 1); } else { if (selected.length >= 3) selected.shift(); selected.push(name); }
      renderSkills(); render();
    });
    $('[data-sug]').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.gen-sug-btn'); if (!b) return;
      roleInput.value = b.dataset.role!; version = 0; full();
    });
    $('[data-tabs]').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-mode]'); if (!b) return;
      mode = b.dataset.mode as typeof mode;
      root.querySelectorAll('[data-tabs] button').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      render(); track('generator_tab', { mode });
    });
    $('[data-next]').addEventListener('click', () => { version = (version + 1) % 3; render(); });

    const copyLabel = $('[data-copy-label]');
    async function doCopy(withPlaceholders: boolean) {
      const text = (result.textContent || '').replace(/\s+/g, ' ').trim();
      try { await navigator.clipboard.writeText(text); } catch {
        const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
      }
      warn.hidden = true;
      const btn = $('[data-copy]'); btn.classList.add('is-copied'); copyLabel.textContent = 'Copied!';
      setTimeout(() => { btn.classList.remove('is-copied'); copyLabel.textContent = 'Copy'; }, 1800);
      const r = role();
      const nextHref = r?.pages.d ? `/job-description/${r.slug}/` : '/resume-bullet-points/';
      const nextText = r?.pages.d ? `${esc(r.name)} job description duties` : 'Bullet point generator';
      after.innerHTML = `<b>Next: the experience section.</b><p>Duty bullets for the jobs under your summary, ready to paste.</p><a class="btn btn-primary btn-sm" href="${nextHref}" data-next-step>${nextText} →</a>`;
      after.hidden = false;
      track(withPlaceholders ? 'copy_with_placeholders' : 'copy', { tool: 'summary', mode, role: r?.slug ?? 'other' });
    }
    $('[data-copy]').addEventListener('click', () => {
      const open = ((result.textContent || '').match(/\[[^\]]*\]/g) || []).length;
      if (open) {
        $('[data-warn-text]').textContent = `${open} detail${open > 1 ? 's' : ''} still in brackets.`;
        warn.hidden = false; after.hidden = true; return;
      }
      doCopy(false);
    });
    $('[data-copy-anyway]').addEventListener('click', () => doCopy(true));
    $('[data-fill-now]').addEventListener('click', () => {
      warn.hidden = true;
      if (!typed()) { roleInput.focus(); return; }
      const m = Array.from(result.querySelectorAll('mark')).find((x) => /\[/.test(x.textContent || ''));
      if (m) { result.focus(); const r = document.createRange(); r.selectNodeContents(m); const s = getSelection()!; s.removeAllRanges(); s.addRange(r); }
    });
    after.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-next-step]')) track('next_step_click', { tool: 'summary' }); });

    full();
  });
</script>
