---
/**
 * Hub cards: one card per profession with the first mid-career example,
 * level links, synonym search and group chips. Roles that only have a
 * job-description page are listed under their group as duty links.
 */
import professions from '../data/professions.json';
import jobDescriptions from '../data/jobDescriptions.json';
import { ROLE_GROUPS, ROLE_BY_SLUG, ROLES } from '../data/roles';

type Ex = { label: string; paragraphs: string[] };
type Prof = { name: string; examples: { entry: Ex[]; mid: Ex[]; senior: Ex[] } };
const P = professions as Record<string, Prof>;
const J = jobDescriptions as Record<string, { name: string; duties: { core: string[] } }>;
const parts = (t: string) => t.split(/(\[[^\]]+\])/g).filter(Boolean);
const groups = ROLE_GROUPS.map((g) => ({
  name: g.name,
  cards: g.slugs.filter((s) => P[s]).map((s) => ({ slug: s, p: P[s], role: ROLE_BY_SLUG[s] })),
  dutyOnly: g.slugs.map((s) => ROLE_BY_SLUG[s]).filter((r) => r && !r.pages.s && r.pages.d),
}));
const searchData = ROLES.map((r) => ({ slug: r.slug, name: r.name, synonyms: r.synonyms }));
---

<section class="rcards" data-rcards>
  <script type="application/json" data-rcards-json set:html={JSON.stringify(searchData)} />
  <div class="container">
    <div class="rc-finder">
      <label class="visually-hidden" for="rc-q">Find your role</label>
      <input id="rc-q" class="rc-q" type="search" placeholder="Find your role, e.g. nurse, babysitter, CDL" autocomplete="off" />
      <div class="rc-chips" role="group" aria-label="Filter by group">
        <button type="button" data-g="" aria-pressed="true">All</button>
        {groups.map((g) => <button type="button" data-g={g.name} aria-pressed="false">{g.name}</button>)}
      </div>
    </div>
    {groups.map((g) => (
      <div class="rc-sector" data-sector={g.name}>
        <h2 class="rc-sector-title">{g.name}</h2>
        {(g.cards.length > 0 || g.dutyOnly.length > 0) && (
          <div class="rc-grid">
            {g.cards.map(({ slug, p }) => (
              <article class="rc-card" data-slug={slug}>
                <a class="rc-main" href={`/resume-summary/${slug}/`}>
                  <span class="rc-top"><b>{p.name} resume summary examples</b><small>20 examples</small></span>
                  <span class="rc-eg">e.g. {p.examples.mid[0].label}</span>
                  <span class="rc-text">{parts(p.examples.mid[0].paragraphs.join(' ')).map((x) => /^\[[^\]]+\]$/.test(x) ? <mark>{x}</mark> : x)}</span>
                </a>
                <span class="rc-levels">
                  <a href={`/resume-summary/${slug}/#entry`}>Entry</a>
                  <a href={`/resume-summary/${slug}/#mid`}>Mid-career</a>
                  <a href={`/resume-summary/${slug}/#senior`}>Senior</a>
                </span>
              </article>
            ))}
            {g.dutyOnly.map((r) => (
              <article class="rc-card rc-card-duty" data-slug={r.slug}>
                <a class="rc-main" href={`/job-description/${r.slug}/`}>
                  <span class="rc-top"><b>{r.name} job description for resume</b><small>Duties</small></span>
                  <span class="rc-eg">Summary examples coming next</span>
                  <span class="rc-text">{parts(J[r.slug].duties.core[0]).map((x) => /^\[[^\]]+\]$/.test(x) ? <mark>{x}</mark> : x)}</span>
                </a>
                <span class="rc-levels"><a href={`/job-description/${r.slug}/`}>Duty bullets →</a></span>
              </article>
            ))}
          </div>
        )}
      </div>
    ))}
    <div class="rc-none card">
      <div>
        <b data-rc-none-title>Don't see your role?</b>
        <span class="muted">Use the generator with any job title, or start from examples for people without direct experience.</span>
      </div>
      <div class="rc-none-actions">
        <a class="btn btn-primary btn-sm" href="/#generator">Open the generator</a>
        <a class="btn btn-ghost btn-sm" href="/no-experience/">No-experience examples</a>
      </div>
    </div>
  </div>
</section>

<style>
  .rcards { padding: 8px 0 40px; }
  .rc-finder { border: 1px solid var(--border); background: var(--bg-subtle); border-radius: var(--r-lg); padding: 14px; display: grid; gap: 12px; }
  .rc-q { font: inherit; width: 100%; padding: 11px 14px; border: 1px solid var(--border-strong); border-radius: var(--r-sm); background: #fff; }
  .rc-q:focus { outline: 2px solid var(--primary); outline-offset: 1px; }
  .rc-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .rc-chips button { font: inherit; font-size: 0.88rem; border: 1px solid var(--border); background: #fff; color: var(--ink-soft); border-radius: 999px; padding: 6px 12px; cursor: pointer; white-space: nowrap; }
  .rc-chips button[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .rc-sector { margin-top: 28px; }
  .rc-sector-title { font-size: 0.8rem; font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 12px; }
  .rc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 900px) { .rc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .rc-grid { grid-template-columns: 1fr; }
    .rc-chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .rc-text { -webkit-line-clamp: 1 !important; }
  }
  .rc-card { border: 1px solid var(--border); border-radius: var(--r-lg); background: #fff; display: flex; flex-direction: column; transition: border-color 0.15s; }
  .rc-card:hover { border-color: var(--primary-border); }
  .rc-main { display: flex; flex-direction: column; gap: 6px; padding: 16px 16px 8px; color: var(--ink); }
  .rc-main:hover { text-decoration: none; }
  .rc-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .rc-top b { font-size: 1rem; }
  .rc-top small { font-size: 0.8rem; color: var(--ink-muted); white-space: nowrap; }
  .rc-eg { font-size: 0.8rem; font-weight: 650; color: var(--primary); }
  .rc-text { font-size: 0.9rem; line-height: 1.55; color: var(--ink-soft); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .rc-text mark { background: #fff3b8; border-bottom: 1px dashed #b58b00; border-radius: 3px; padding: 0 1px; color: inherit; }
  .rc-levels { display: flex; gap: 6px; padding: 0 16px 14px; margin-top: auto; }
  .rc-levels a { font-size: 0.78rem; font-weight: 650; border-radius: 6px; padding: 2px 8px; background: var(--bg-subtle); color: var(--ink-soft); }
  .rc-levels a:hover { background: var(--primary-soft); color: var(--primary); text-decoration: none; }
  .rc-card-duty { background: var(--bg-subtle); }
  .rc-card-duty .rc-eg { color: var(--ink-muted); }
  .rc-none { margin-top: 28px; display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; border-style: dashed; }
  .rc-none b { display: block; font-size: 1.05rem; }
  .rc-none-actions { display: flex; gap: 8px; flex-wrap: wrap; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-rcards]').forEach((root) => {
    const roles: { slug: string; name: string; synonyms: string[] }[] = JSON.parse(root.querySelector('[data-rcards-json]')!.textContent || '[]');
    const q = root.querySelector<HTMLInputElement>('#rc-q')!;
    let group = '';
    const match = (input: string) => {
      const t = input.toLowerCase().trim(); let best = '', score = 0;
      for (const r of roles) for (const c of [r.name.toLowerCase(), ...r.synonyms]) {
        const s = t === c ? 100 + c.length : c.length >= 3 && t.includes(c) ? c.length : 0;
        if (s > score) { score = s; best = r.slug; }
      }
      return best;
    };
    const fits = (slug: string, t: string, m: string) => {
      if (!t) return true;
      const r = roles.find((x) => x.slug === slug); if (!r) return false;
      return m === slug || [r.name.toLowerCase(), ...r.synonyms].some((c) => c.includes(t));
    };
    function apply() {
      const t = q.value.toLowerCase().trim(); const m = match(t); let any = 0;
      root.querySelectorAll<HTMLElement>('[data-sector]').forEach((sec) => {
        let n = 0;
        const inGroup = !group || sec.dataset.sector === group;
        sec.querySelectorAll<HTMLElement>('[data-slug]').forEach((el) => { const ok = inGroup && fits(el.dataset.slug!, t, m); el.hidden = !ok; if (ok) n++; });
        sec.hidden = n === 0; any += n;
      });
      root.querySelector('[data-rc-none-title]')!.textContent = any ? "Don't see your role?" : `No guide for "${q.value.trim()}" yet`;
    }
    q.addEventListener('input', apply);
    root.querySelector('.rc-chips')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (!b) return;
      group = b.dataset.g || '';
      root.querySelectorAll('.rc-chips button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    });
  });
</script>
