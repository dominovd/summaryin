---
/** A copyable example block. `label` shows in the card header. */
interface Props {
  label: string;
  paragraphs: string[];
  icon?: 'entry' | 'mid' | 'senior';
}
const { label, paragraphs, icon = 'mid' } = Astro.props;
const icons = {
  entry: 'M8 1.5l2 4.1 4.5.6-3.3 3.2.8 4.4L8 11.7l-4 2.1.8-4.4L1.5 6.2l4.5-.6L8 1.5z',
  mid: 'M2 13.5V6l6-3.5L14 6v7.5M6 13.5V9h4v4.5',
  senior: 'M8 1.5l1.8 3.7 4.2.6-3 2.9.7 4.1L8 10.9l-3.7 1.9.7-4.1-3-2.9 4.2-.6L8 1.5z',
};
const parts = (text: string) => text.split(/(\[[^\]]+\])/g).filter(Boolean);
---

<article class="copy-block card">
  <header class="copy-head">
    <span class="copy-icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d={icons[icon]} stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      </svg>
    </span>
    <h3>{label}</h3>
  </header>
  <div class="copy-text" data-copy-source>
    {paragraphs.map((p) => (
      <p>{parts(p).map((part) => /^\[[^\]]+\]$/.test(part) ? <mark>{part}</mark> : part)}</p>
    ))}
  </div>
  <button type="button" class="btn btn-secondary copy-btn" data-copy-example>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.7"/>
      <path d="M10.5 5.5v-2A1.5 1.5 0 0 0 9 2H4a1.5 1.5 0 0 0-1.5 1.5v5A1.5 1.5 0 0 0 4 10h1.5" stroke="currentColor" stroke-width="1.7"/>
    </svg>
    <span>Copy</span>
  </button>
</article>

<style>
  .copy-block { display: flex; flex-direction: column; }
  .copy-head { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .copy-head h3 { margin: 0; font-size: 1.02rem; }
  .copy-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary);
    flex: none;
  }
  .copy-text { flex: 1; color: var(--ink-soft); font-size: 0.97rem; }
  .copy-text p { margin-bottom: 0.8em; }
  .copy-text mark {
    padding: 1px 3px;
    border-bottom: 1px dashed #b58b00;
    border-radius: 3px;
    background: #fff3b8;
    color: var(--ink);
  }
  .copy-btn { margin-top: 14px; padding: 9px 16px; font-size: 0.93rem; }
</style>
