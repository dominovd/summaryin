---
/** Block 11 of the template: related searches, plain text chips (no links to nowhere). */
interface Props {
  keywords: string[];
  heading?: string;
}
const { keywords, heading = 'People also search for' } = Astro.props;
---

<section class="section" aria-labelledby="related-kw-heading">
  <div class="container">
    <h2 id="related-kw-heading" class="rk-heading">{heading}</h2>
    <ul class="rk-list">
      {keywords.map((k) => <li>{k}</li>)}
    </ul>
  </div>
</section>

<style>
  .rk-heading { font-size: 1.2rem; }
  .rk-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .rk-list li {
    font-size: 0.92rem;
    color: var(--ink-soft);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 14px;
  }
</style>
