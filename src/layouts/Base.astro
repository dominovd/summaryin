---
import '../styles/global.css';
import { SITE, NAV_GROUPS } from '../data/site';

interface Props {
  /** Exact-match keyword goes first; year token is appended automatically. */
  title: string;
  description: string;
  /** Set false to skip the reviewed-year token in <title>. Long titles skip it automatically. */
  yearInTitle?: boolean;
  /** Use only for unfinished pages that should stay out of search results. */
  noindex?: boolean;
}

const { title, description, yearInTitle = true, noindex = false } = Astro.props;
const useTitleYear = yearInTitle && title.length <= 40;
const fullTitle = useTitleYear ? `${title} (${SITE.contentYear}) | ${SITE.name}` : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/#generator' && path.startsWith(href.replace(/#.*$/, '')) && href !== '/';
const socialImage = new URL('/images/summaryin-social.png', SITE.url).href;
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      logo: new URL('/favicon.svg', SITE.url).href,
      email: SITE.contactEmail,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.tagline,
      publisher: { '@id': `${SITE.url}/#organization` },
      inLanguage: 'en-US',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="google-site-verification" content="bVZTt4hRtEYg29b201Vmc_-AfLNmym--ei3anQLHwb4" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SummaryIn resume writing tools and examples" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Browsers and Googlebot request /favicon.ico by default. Without a real
         file there, every request became a 404 in Search Console crawl stats. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label={`${SITE.name} home`}>
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect x="1.5" y="1.5" width="25" height="25" rx="7" stroke="currentColor" stroke-width="2.4"/>
            <path d="M8 10.5h12M8 14h12M8 17.5h7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
            <path d="M17.5 19.5l2 2 3.5-4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{SITE.name}</span>
        </a>
        <nav aria-label="Main" class="main-nav">
          <ul class="nav-list">
            {NAV_GROUPS.map((g, gi) => (
              <li class="dd" data-dd>
                <button type="button" class:list={['dd-btn', { active: g.items.some((i) => isActive(i.href)) }]} aria-expanded="false" aria-controls={`dd-${gi}`}>
                  {g.label}
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="dd-panel" id={`dd-${gi}`}>
                  <ul>
                    {g.items.map((i) => (
                      <li><a href={i.href} aria-current={isActive(i.href) ? 'page' : undefined}><b>{i.label}</b><span>{i.note}</span></a></li>
                    ))}
                  </ul>
                </div>
              </li>
            ))}
          </ul>
        </nav>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Mobile">
            {NAV_GROUPS.map((g) => (
              <div class="m-group">
                <p class="m-label">{g.label}</p>
                <ul>
                  {g.items.map((i) => <li><a href={i.href} aria-current={isActive(i.href) ? 'page' : undefined}>{i.label}</a></li>)}
                </ul>
              </div>
            ))}
            <a class="btn btn-primary m-cta" href="/#generator">Write my summary</a>
          </nav>
        </details>
        <a class="btn btn-primary header-cta" href="/#generator">Write my summary</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <script>
      // Vercel Web Analytics (no Speed Insights). No-op in local dev;
      // enable Analytics in the Vercel dashboard: Project → Analytics.
      import { inject } from '@vercel/analytics';
      inject();

      // Header dropdowns: hover opens them on desktop (CSS), click and keyboard everywhere.
      const dds = Array.from(document.querySelectorAll<HTMLElement>('[data-dd]'));
      const close = (except?: HTMLElement) => dds.forEach((d) => {
        if (d === except) return;
        d.classList.remove('open');
        d.querySelector('.dd-btn')?.setAttribute('aria-expanded', 'false');
      });
      dds.forEach((d) => {
        const btn = d.querySelector<HTMLButtonElement>('.dd-btn')!;
        d.addEventListener('mouseenter', () => close(d));
        d.addEventListener('mouseleave', () => d.classList.remove('no-hover'));
        btn.addEventListener('click', () => {
          const open = !d.classList.contains('open');
          close(d);
          d.classList.toggle('open', open);
          btn.setAttribute('aria-expanded', String(open));
        });
      });
      document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('[data-dd]')) close(); });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const open = dds.find((d) => d.classList.contains('open') || d.matches(':hover'));
        close();
        open?.classList.add('no-hover');
        open?.querySelector<HTMLButtonElement>('.dd-btn')?.focus();
      });
    </script>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <a href="/" class="logo logo-footer">
            <svg width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true">
              <rect x="1.5" y="1.5" width="25" height="25" rx="7" stroke="currentColor" stroke-width="2.4"/>
              <path d="M8 10.5h12M8 14h12M8 17.5h7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
              <path d="M17.5 19.5l2 2 3.5-4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{SITE.name}</span>
          </a>
          <p class="muted">{SITE.tagline}</p>
        </div>
        <nav class="footer-col" aria-label="Resume">
          <h3>Resume</h3>
          <ul>
            <li><a href="/resume-summary/">Resume summaries</a></li>
            <li><a href="/no-experience/">No-experience summaries</a></li>
            <li><a href="/job-description/">Job descriptions</a></li>
            <li><a href="/resume-bullet-points/">Bullet point generator</a></li>
          </ul>
        </nav>
        <nav class="footer-col" aria-label="Resources">
          <h3>Resources</h3>
          <ul>
            <li><a href="/#faq">FAQ</a></li>
            <li><a href="/resume-summary/customer-service/#power-words">Power words</a></li>
          </ul>
        </nav>
        <nav class="footer-col" aria-label="Company">
          <h3>Company</h3>
          <ul>
            <li><a href="/about/">About us</a></li>
            <li><a href="/editorial-policy/">Editorial policy</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </nav>
      </div>
      <div class="container footer-legal">
        <p>
          © {SITE.year} {SITE.name}.com · All rights reserved ·
          <a href="/privacy/">Privacy Policy</a> · <a href="/terms/">Terms of Use</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 64px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--ink);
  }
  .logo svg { color: var(--primary); }
  .logo:hover { text-decoration: none; }
  .main-nav { height: 100%; }
  .nav-list { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; height: 100%; }
  .dd { position: relative; display: flex; align-items: center; }
  .dd-btn {
    font: inherit; font-weight: 600; font-size: 0.97rem; color: var(--ink-soft);
    background: none; border: 0; cursor: pointer; padding: 8px 12px; border-radius: var(--r-sm);
    display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
  }
  .dd-btn svg { transition: transform 0.15s; opacity: 0.7; }
  .dd-btn:hover, .dd.open .dd-btn { color: var(--ink); background: var(--bg-subtle); }
  .dd-btn.active { color: var(--primary); }
  .dd.open .dd-btn svg { transform: rotate(180deg); }
  .dd-panel {
    display: none; position: absolute; top: 100%; left: -8px; padding-top: 8px; z-index: 60;
  }
  .dd.open .dd-panel { display: block; }
  @media (hover: hover) and (min-width: 901px) {
    .dd:not(.no-hover):hover .dd-panel { display: block; }
    .dd:hover .dd-btn { color: var(--ink); background: var(--bg-subtle); }
    .dd:hover .dd-btn svg { transform: rotate(180deg); }
  }
  .dd-panel ul {
    list-style: none; margin: 0; padding: 8px; width: 300px; background: #fff;
    border: 1px solid var(--border); border-radius: var(--r-md); box-shadow: var(--shadow-card);
  }
  .dd-panel a { display: block; padding: 9px 12px; border-radius: var(--r-sm); color: var(--ink); }
  .dd-panel a:hover, .dd-panel a:focus-visible { background: var(--bg-subtle); text-decoration: none; }
  .dd-panel a[aria-current="page"] b { color: var(--primary); }
  .dd-panel b { display: block; font-size: 0.95rem; font-weight: 650; }
  .dd-panel span { display: block; font-size: 0.84rem; color: var(--ink-muted); margin-top: 1px; }
  .header-cta { margin-left: auto; padding: 9px 16px; font-size: 0.95rem; }
  .mobile-nav { display: none; margin-left: auto; position: relative; }
  .mobile-nav summary {
    list-style: none;
    cursor: pointer;
    color: var(--primary);
    font-weight: 650;
    border: 1px solid var(--primary-border);
    border-radius: var(--r-sm);
    padding: 8px 13px;
  }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav nav {
    position: absolute;
    right: 0;
    top: calc(100% + 9px);
    width: min(280px, calc(100vw - 32px));
    max-height: calc(100vh - 90px);
    overflow-y: auto;
    padding: 10px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-card);
  }
  .mobile-nav ul { list-style: none; margin: 0; padding: 0; }
  .m-group + .m-group { border-top: 1px solid var(--border); margin-top: 6px; padding-top: 6px; }
  .m-label { margin: 4px 10px 2px; font-size: 0.74rem; font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
  .mobile-nav a:not(.btn) { display: block; padding: 8px 10px; color: var(--ink-soft); font-weight: 600; }
  .mobile-nav a[aria-current="page"] { color: var(--primary); }
  .m-cta { display: block; text-align: center; margin-top: 10px; }
  @media (max-width: 900px) {
    .main-nav { display: none; }
    .mobile-nav { display: block; }
    .header-cta { display: none; }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    margin-top: 64px;
    padding: 44px 0 0;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 32px;
  }
  @media (max-width: 720px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
  .logo-footer { font-size: 1.02rem; }
  .footer-brand p { margin-top: 10px; font-size: 0.95rem; max-width: 30ch; }
  .footer-col h3 { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-muted); }
  .footer-col ul { list-style: none; margin: 0; padding: 0; }
  .footer-col li { margin-bottom: 8px; }
  .footer-col a { color: var(--ink-soft); font-size: 0.97rem; }
  .footer-legal {
    margin-top: 32px;
    padding-top: 18px;
    padding-bottom: 18px;
    border-top: 1px solid var(--border);
  }
  .footer-legal p { margin: 0; font-size: 0.9rem; color: var(--ink-muted); }
  .footer-legal a { color: var(--ink-muted); text-decoration: underline; }
  .footer-legal a:hover { color: var(--ink-soft); }
</style>
