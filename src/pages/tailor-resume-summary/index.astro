---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import AppJsonLd from '../../components/AppJsonLd.astro';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import { ROLES } from '../../data/roles';

const roles = ROLES.map((r) => ({ slug: r.slug, name: r.name, synonyms: r.synonyms, skills: r.skills }));
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const description = 'Paste a job posting, tick the keywords you really have, and get a resume summary tailored to that job. Numbers you did not give stay as [X].';
const faq = [
  {
    q: 'How do I tailor a resume summary to a job description?',
    a: 'Find the skills, tools, and duties the posting repeats, keep only the ones you have actually used, and work them into a two or three sentence summary that starts with the job title. This tool pulls the keywords for you and writes the draft from your own facts.',
  },
  {
    q: 'Will it add skills or experience I do not have?',
    a: 'No. Only keywords you tick are used, and every draft is checked against what you entered. Any number, employer, or certification you did not give is rejected, and missing numbers are left as [X] for you to fill in.',
  },
  {
    q: 'Is the tailoring tool free?',
    a: 'Yes. You can create up to five tailored summaries per day without an account. The regular summary generator has no limit and runs fully in your browser.',
  },
  {
    q: 'What happens to the job posting and details I paste?',
    a: 'They are sent to an AI provider to write the text and returned to your browser. SummaryIn does not store them. See the privacy policy for details.',
  },
];
---

<Base title="Tailor Your Resume Summary to a Job Posting" description={description}>
  <AppJsonLd name="Resume Summary Tailoring Tool" description={description} path="/tailor-resume-summary/" />
  <BreadcrumbJsonLd items={[{ name: 'Home', href: '/' }, { name: 'Tailor to a job', href: '/tailor-resume-summary/' }]} />
  <script is:inline slot="head">if (new URLSearchParams(location.search).get('embed') === '1') document.documentElement.dataset.embed = '1';</script>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}

  <section class="section tl-hero">
    <div class="container narrow">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <span>Tailor to a job</span></nav>
      <h1>Tailor Your Resume Summary to a Job Posting</h1>
      <p class="lead">Paste the posting, tick only the keywords you have really used, and get a summary written for that job. Anything you did not tell us stays as a [X] placeholder.</p>
    </div>
  </section>

  <section class="section tl" data-tailor data-sitekey={siteKey}>
    <script type="application/json" data-roles set:html={JSON.stringify(roles)} />
    <div class="container narrow">
      <p class="tl-off" data-off hidden>The tailoring tool is not switched on yet. The <a href="/#generator">free generator</a> works right now.</p>

      <div class="tl-step tl-s-about">
        <h2><span>1</span> About you</h2>
        <div class="tl-sum" data-asum hidden><span data-asum-text></span><button type="button" data-asum-edit>Edit</button></div>
        <div class="tl-body" data-abody>
        <div class="tl-row">
          <label>Job title you are applying for
            <input type="text" name="title" maxlength="60" placeholder="e.g. Retail Sales Associate" autocomplete="off" required />
          </label>
          <div class="tl-lvl" role="group" aria-label="Experience level">
            <span>Level</span>
            {[['entry', 'Entry'], ['mid', 'Mid'], ['senior', 'Senior']].map(([k, l]) => <button type="button" data-lvl={k} aria-pressed={k === 'mid' ? 'true' : 'false'}>{l}</button>)}
          </div>
        </div>
        <label>Your skills, comma separated
          <input type="text" name="skills" maxlength="400" placeholder="e.g. POS systems, cash handling, visual merchandising" autocomplete="off" />
        </label>
        <div class="tl-sugg" data-sugg hidden></div>
        <label>Facts you can back up <small>(optional, but this is what makes it yours)</small>
          <textarea name="facts" rows="3" maxlength="600" placeholder="e.g. 2 years at a sporting goods store, trained 4 new hires, top seller in March"></textarea>
        </label>
        <p class="tl-saved muted" data-saved hidden>Your details are saved in this browser for the next posting. <button type="button" data-clear>Clear my details</button></p>
        </div>
      </div>

      <div class="tl-step tl-s-post">
        <h2><span>2</span> The job posting</h2>
        <div class="tl-sum" data-psum hidden><span data-psum-text></span><button type="button" data-psum-edit>Edit</button></div>
        <div class="tl-body" data-pbody>
          <label class="visually-hidden" for="tl-posting">Job posting</label>
          <textarea id="tl-posting" name="posting" rows="8" maxlength="6000" placeholder="Paste the full job posting here"></textarea>
        </div>
        <div class="tl-acts">
          <button type="button" class="btn btn-ghost" data-extract>Find keywords</button>
          <span class="muted tl-msg" data-msg1 aria-live="polite"></span>
        </div>
        <fieldset class="tl-kw" data-kw hidden>
          <legend>Tick only what you have really done or used</legend>
          <div data-kw-list></div>
        </fieldset>
      </div>

      <div class="tl-step tl-s-out">
        <h2><span>3</span> Your tailored summary</h2>
        <div class="tl-ts" data-ts></div>
        <div class="tl-acts">
          <button type="button" class="btn btn-primary" data-write>Write my summary</button>
          <span class="muted tl-msg" data-msg2 aria-live="polite"></span>
        </div>
        <div class="tl-out" data-out hidden>
          <div class="tl-text" data-text contenteditable="true" spellcheck="true" aria-label="Tailored summary, editable"></div>
          <p class="muted tl-note" data-note></p>
          <div class="tl-gap" data-gap hidden>
            <p class="tl-gap-h" data-gap-h></p>
            <div class="tl-gap-list" data-gap-list></div>
            <p class="muted tl-gap-note">Tick a keyword above only if you have really done it, then write again.</p>
          </div>
          <div class="tl-acts">
            <button type="button" class="btn btn-primary btn-sm" data-copy>Copy summary</button>
            <a class="btn btn-ghost btn-sm" href="/resume-bullet-points/">Next: bullet points →</a>
          </div>
        </div>
      </div>

      <p class="tl-privacy-short muted">Sent to an AI provider to write the text, not stored. Up to 5 a day. <a href="/privacy/">Privacy</a></p>
      <div class="tl-bar" data-bar hidden>
        <button type="button" class="btn btn-primary" data-bar-main>Find keywords</button>
        <button type="button" class="btn btn-ghost btn-sm" data-bar-alt hidden>Write again</button>
      </div>
      <p class="tl-privacy muted" data-privacy>To write the text, this tool sends the posting and what you type to an AI provider. SummaryIn does not store it. Up to <b data-limit>5</b> tailored summaries per day. The <a href="/#generator">free generator</a> runs fully in your browser.</p>
    </div>
  </section>

  <section class="section section-subtle tl-how" aria-labelledby="how-heading">
    <div class="container narrow">
      <h2 id="how-heading">Why tailoring works, and where it goes wrong</h2>
      <p>Recruiters and applicant tracking systems often search for the words a posting uses, so a summary that names the same tools and duties is easier to match. The risk is copying keywords you cannot back up in an interview.</p>
      <div class="tl-grid">
        <div class="card"><h3>Keep</h3><p>Tools, duties, and certifications from the posting that you have really used. Name them the way the posting does.</p></div>
        <div class="card"><h3>Skip</h3><p>Soft words like team player or self-starter, perks, schedule details, and any requirement you do not meet yet.</p></div>
        <div class="card"><h3>Prove</h3><p>Add one result with a number. If you do not know it exactly, leave [X] and check before you apply.</p></div>
      </div>
      <p class="muted">Need more than one sentence per job? Use the <a href="/resume-bullet-points/">bullet point builder</a> or the <a href="/job-description/">job description examples</a> for the experience section.</p>
    </div>
  </section>

  <Faq items={faq} heading="Tailoring FAQ" />
</Base>

<style>
  .narrow { max-width: 760px; }
  .tl-hero { padding-bottom: 8px; }
  .crumbs { font-size: 0.88rem; color: var(--ink-muted); margin-bottom: 14px; }
  .crumbs a { color: var(--ink-muted); }
  .tl { padding-top: 8px; }
  .tl-off { background: #fff7e0; border: 1px solid #f1d58a; border-radius: var(--r-md); padding: 12px 14px; }
  .tl-step { border: 1px solid var(--border); border-radius: var(--r-lg); padding: 18px; margin-bottom: 14px; background: #fff; display: grid; gap: 12px; }
  .tl-step h2 { font-size: 1.1rem; margin: 0; display: flex; align-items: center; gap: 10px; }
  .tl-step h2 span { width: 26px; height: 26px; border-radius: 50%; background: var(--primary-soft); color: var(--primary); font-size: 0.85rem; display: inline-grid; place-items: center; }
  .tl label { display: grid; gap: 6px; font-weight: 650; font-size: 0.92rem; }
  .tl label small { font-weight: 400; color: var(--ink-muted); }
  .tl input[type="text"], .tl textarea { font: inherit; font-weight: 400; width: 100%; padding: 10px 12px; border: 1px solid var(--border-strong); border-radius: var(--r-sm); background: #fff; }
  .tl textarea { resize: vertical; }
  .tl-row { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: end; }
  @media (max-width: 600px) { .tl-row { grid-template-columns: 1fr; } }
  .tl-lvl { display: flex; align-items: center; gap: 6px; font-size: 0.9rem; font-weight: 650; }
  .tl-lvl button, .tl-sugg :global(button) { font: inherit; font-size: 0.86rem; border: 1px solid var(--border); background: #fff; color: var(--ink-soft); border-radius: 999px; padding: 6px 12px; cursor: pointer; }
  .tl-lvl button[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .tl-sugg { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: 0.86rem; color: var(--ink-muted); }
  .tl-sugg :global(button)::before { content: '+ '; }
  .tl-acts { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .tl-msg { font-size: 0.9rem; }
  .tl-msg.err { color: #b42318; }
  .tl-kw { border: 1px dashed var(--border-strong); border-radius: var(--r-md); padding: 10px 14px; margin: 0; }
  .tl-kw legend { font-weight: 650; font-size: 0.9rem; padding: 0 6px; }
  .tl-kw [data-kw-list] { display: flex; flex-wrap: wrap; gap: 8px; }
  .tl-kw :global(label) { display: inline-flex; align-items: center; gap: 6px; font-weight: 500; border: 1px solid var(--border); border-radius: 999px; padding: 5px 12px; cursor: pointer; }
  .tl-kw :global(label:has(input:checked)) { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); }
  .tl-kw :global(small) { color: var(--ink-muted); font-size: 0.75rem; }
  .tl-out { display: grid; gap: 10px; }
  .tl-text { border: 1px solid var(--border); border-radius: var(--r-md); padding: 14px 16px; line-height: 1.65; background: var(--bg-subtle); }
  .tl-text :global(mark) { background: #fff3b8; border-radius: 3px; padding: 0 2px; color: inherit; }
  .tl-note { font-size: 0.86rem; margin: 0; }
  .tl-gap { border: 1px solid #f1d58a; background: #fffbea; border-radius: var(--r-md); padding: 12px 14px; display: grid; gap: 8px; }
  .tl-gap-h { margin: 0; font-weight: 650; font-size: 0.92rem; }
  .tl-gap-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .tl-gap-list :global(span) { border: 1px dashed #c9a227; border-radius: 999px; padding: 3px 10px; font-size: 0.86rem; background: #fff; }
  .tl-gap-note { margin: 0; font-size: 0.84rem; }
  .tl-privacy { font-size: 0.86rem; margin-top: 6px; }
  .tl-saved { font-size: 0.84rem; margin: 0; }
  .tl-body { display: grid; gap: 12px; }
  .tl-sum { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: var(--bg-subtle); border-radius: var(--r-sm); padding: 8px 12px; font-size: 0.9rem; color: var(--ink-soft); }
  .tl-sum span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tl-sum button, .tl-saved button { font: inherit; background: none; border: 0; padding: 0; color: var(--primary); text-decoration: underline; cursor: pointer; flex: none; }
  .tl-privacy-short, .tl-bar { display: none; }
  .tl-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 16px 0; }
  @media (max-width: 700px) { .tl-grid { grid-template-columns: 1fr; } }
  .tl-grid h3 { font-size: 1rem; margin: 0 0 4px; }
  .tl-grid p { margin: 0; font-size: 0.93rem; color: var(--ink-soft); }
</style>

<style is:global>
  /* ?embed=1: the page inside the Chrome extension side panel (360 to 480 px). Compact, posting first, one action bar. */
  html[data-embed] .site-header,
  html[data-embed] .site-footer,
  html[data-embed] .tl-hero,
  html[data-embed] .tl-how,
  html[data-embed] #faq,
  html[data-embed] .tl-privacy,
  html[data-embed] .tl-step h2 span,
  html[data-embed] [data-extract],
  html[data-embed] [data-write],
  html[data-embed] .tl-out .tl-acts { display: none !important; }
  html[data-embed] body { font-size: 14.5px; }
  html[data-embed] main { min-height: 100vh; display: flex; flex-direction: column; }
  html[data-embed] .tl { padding: 0; flex: 1; display: flex; }
  html[data-embed] .tl > .container { padding: 0 14px; display: flex; flex-direction: column; flex: 1; }
  html[data-embed] .tl-off { order: 0; margin: 12px 0 0; font-size: 0.88rem; padding: 8px 10px; }
  html[data-embed] .tl-s-post { order: 1; }
  html[data-embed] .tl-s-about { order: 2; }
  html[data-embed] .tl-s-out { order: 3; }
  html[data-embed] .tl-step { border: 0; border-bottom: 1px solid var(--border); border-radius: 0; padding: 14px 0; margin: 0; gap: 10px; background: none; }
  html[data-embed] .tl-step h2 { font-size: 0.98rem; }
  html[data-embed] .tl label { font-size: 0.85rem; gap: 4px; }
  html[data-embed] .tl input[type="text"], html[data-embed] .tl textarea { padding: 8px 10px; font-size: 0.92rem; }
  html[data-embed] .tl textarea[name="posting"] { max-height: 180px; }
  html[data-embed] .tl-lvl { font-size: 0.85rem; }
  html[data-embed] .tl-lvl button { padding: 4px 10px; font-size: 0.82rem; }
  html[data-embed] .tl-row { grid-template-columns: 1fr; gap: 10px; }
  html[data-embed] .tl-kw { padding: 8px 10px; }
  html[data-embed] .tl-kw legend { font-size: 0.85rem; }
  html[data-embed] .tl-kw [data-kw-list] { gap: 6px; }
  html[data-embed] .tl-kw label { padding: 3px 10px; font-size: 0.85rem; }
  html[data-embed] .tl-text { padding: 10px 12px; font-size: 0.93rem; line-height: 1.6; }
  html[data-embed] .tl-note, html[data-embed] .tl-gap { font-size: 0.82rem; }
  html[data-embed] .tl-gap { padding: 10px 12px; }
  html[data-embed] .tl-acts:has(> .tl-msg:empty) { display: none; }
  html[data-embed] .tl-privacy-short { display: block; order: 4; font-size: 0.78rem; margin: 10px 0 0; }
  html[data-embed] .tl-bar { display: flex; order: 5; gap: 8px; align-items: center; position: sticky; bottom: 0; margin: auto -14px 0; padding: 10px 14px; background: #fff; border-top: 1px solid var(--border); }
  html[data-embed] .tl-bar [data-bar-main] { flex: 1; padding: 10px 14px; }
</style>

<script>
  import { track } from '@vercel/analytics';
  import { isEmbed, withSurface, listenForPostings, linksToNewTab, loadProfile, saveProfile, clearProfile } from '../../lib/embed';

  declare const turnstile: { render: (el: HTMLElement, o: object) => string; getResponse: (id: string) => string; reset: (id: string) => void } | undefined;

  const root = document.querySelector<HTMLElement>('[data-tailor]');
  if (root) {
    const roles: { slug: string; name: string; synonyms: string[]; skills: string[] }[] = JSON.parse(root.querySelector('[data-roles]')!.textContent || '[]');
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const title = $<HTMLInputElement>('[name=title]');
    const skills = $<HTMLInputElement>('[name=skills]');
    const facts = $<HTMLTextAreaElement>('[name=facts]');
    const posting = $<HTMLTextAreaElement>('[name=posting]');
    const msg1 = $('[data-msg1]'); const msg2 = $('[data-msg2]');
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    let level = 'mid';
    const qs = new URLSearchParams(location.search);
    if (qs.get('title')) title.value = qs.get('title')!.slice(0, 60);
    const qLevel = qs.get('level');
    if (qLevel && ['entry', 'mid', 'senior'].includes(qLevel)) {
      level = qLevel;
      root.querySelectorAll('.tl-lvl button').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.lvl === qLevel)));
    }

    // Profile remembered between postings (site and extension panel).
    const saved = loadProfile();
    const savedNote = $('[data-saved]');
    if (!qs.get('title') && saved.title) title.value = saved.title.slice(0, 60);
    if (!qLevel && saved.level && ['entry', 'mid', 'senior'].includes(saved.level)) {
      level = saved.level;
      root.querySelectorAll('.tl-lvl button').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.lvl === level)));
    }
    if (saved.skills) skills.value = saved.skills.slice(0, 400);
    if (saved.facts) facts.value = saved.facts.slice(0, 600);
    savedNote.hidden = !(saved.title || saved.skills || saved.facts);
    let saveTimer = 0;
    const remember = () => {
      clearTimeout(saveTimer);
      saveTimer = window.setTimeout(() => {
        saveProfile({ title: title.value, level, skills: skills.value, facts: facts.value });
        savedNote.hidden = !(title.value.trim() || skills.value.trim() || facts.value.trim());
      }, 400);
    };
    [title, skills, facts].forEach((el) => el.addEventListener('input', remember));
    $('[data-clear]').addEventListener('click', () => {
      clearTimeout(saveTimer);
      clearProfile();
      title.value = ''; skills.value = ''; facts.value = '';
      level = 'mid';
      root.querySelectorAll('.tl-lvl button').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.lvl === 'mid')));
      suggest();
      savedNote.hidden = true;
      aboutOpen = true;
      compact();
    });

    let fromSite = '';
    let postingOpen = false;
    let aboutOpen = !saved.title;
    const embed = isEmbed();
    if (embed) linksToNewTab();
    listenForPostings((text, jobSite) => {
      posting.value = text;
      fromSite = jobSite || '';
      postingOpen = false;
      posting.dispatchEvent(new Event('input', { bubbles: true }));
      compact();
    });

    let widget = '';

    function matchRole(input: string, list: typeof roles) {
      const q = input.toLowerCase().trim(); let best: string | null = null; let score = 0;
      for (const r of list) for (const c of [r.name.toLowerCase(), ...r.synonyms]) {
        const s = q === c ? 100 + c.length : c.length >= 3 && q.includes(c) ? c.length : 0;
        if (s > score) { score = s; best = r.slug; }
      }
      return best;
    }

    const siteKey = root.dataset.sitekey;
    if (siteKey) {
      const mount = () => {
        if (typeof turnstile === 'undefined') return setTimeout(mount, 300);
        widget = turnstile.render($('[data-ts]'), { sitekey: siteKey, size: 'flexible', appearance: 'interaction-only' });
      };
      mount();
    }
    async function token() {
      if (!widget || typeof turnstile === 'undefined') return '';
      for (let i = 0; i < 40; i++) {
        const t = turnstile.getResponse(widget);
        if (t) return t;
        await new Promise((r) => setTimeout(r, 250));
      }
      return '';
    }
    const resetToken = () => { if (widget && typeof turnstile !== 'undefined') turnstile.reset(widget); };

    fetch('/api/tailor/').then((r) => r.json()).then((s) => {
      $('[data-limit]').textContent = String(s.limit ?? 5);
      if (!s.ready) off();
      else if (s.left < s.limit) msg2.textContent = `${s.left} of ${s.limit} left today`;
    }).catch(off);
    function off() {
      $('[data-off]').hidden = false;
      root!.querySelectorAll<HTMLButtonElement>('[data-extract],[data-write]').forEach((b) => (b.disabled = true));
    }

    root.querySelector('.tl-lvl')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (!b) return;
      level = b.dataset.lvl!;
      root.querySelectorAll('.tl-lvl button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      remember();
    });

    const sugg = $('[data-sugg]');
    function suggest() {
      const slug = matchRole(title.value, roles);
      const have = skills.value.toLowerCase();
      const list = slug ? roles.find((r) => r.slug === slug)!.skills.filter((s) => !have.includes(s.toLowerCase())).slice(0, 6) : [];
      sugg.hidden = !list.length;
      sugg.innerHTML = list.length ? `<span>Common for this role:</span>${list.map((s) => `<button type="button" data-s="${esc(s)}">${esc(s)}</button>`).join('')}` : '';
    }
    title.addEventListener('input', suggest);
    if (title.value) suggest();
    sugg.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (!b) return;
      skills.value = [skills.value.trim().replace(/,$/, ''), b.dataset.s].filter(Boolean).join(', ');
      suggest();
      remember();
    });

    async function call(body: object) {
      const res = await fetch('/api/tailor/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...body, token: await token() }) });
      const data = await res.json().catch(() => ({ error: 'Something went wrong.' }));
      resetToken();
      if (!res.ok) throw new Error(data.error || 'Something went wrong.');
      return data;
    }
    const say = (el: HTMLElement, t: string, err = false) => { el.textContent = t; el.classList.toggle('err', err); };

    const kw = $('[data-kw]'); const kwList = $('[data-kw-list]');
    posting.addEventListener('input', () => {
      delete root.dataset.stage;
      if (kwList.innerHTML) { kw.hidden = true; kwList.innerHTML = ''; say(msg1, ''); }
    });
    $('[data-extract]').addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      b.disabled = true; say(msg1, 'Reading the posting...');
      kw.hidden = true; kwList.innerHTML = ''; $('[data-gap]').hidden = true;
      try {
        const { keywords } = await call({ step: 'extract', posting: posting.value, title: title.value });
        kw.hidden = !keywords.length;
        kwList.innerHTML = keywords.map((k: { term: string; type: string }) => `<label><input type="checkbox" value="${esc(k.term)}" /> ${esc(k.term)} <small>${esc(k.type)}</small></label>`).join('');
        say(msg1, keywords.length ? `${keywords.length} keywords found.` : 'No clear keywords found. You can still write a summary.');
        root.dataset.stage = 'keywords';
        track('tailor', withSurface({ step: 'extract', found: keywords.length }));
      } catch (err) { say(msg1, (err as Error).message, true); }
      b.disabled = false;
    });

    $('[data-write]').addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      const confirmed = Array.from(kwList.querySelectorAll<HTMLInputElement>('input:checked')).map((x) => x.value);
      b.disabled = true; say(msg2, 'Writing...');
      try {
        const r = await call({ step: 'write', title: title.value, level, skills: skills.value, facts: facts.value, confirmed });
        $('[data-out]').hidden = false;
        $('[data-text]').innerHTML = esc(r.summary).replace(/\[([^\]]+)\]/g, '<mark>[$1]</mark>');
        $('[data-note]').textContent = r.source === 'template'
          ? 'We could not write a version that only uses your facts, so here is a safe template. Add a fact or two and try again.'
          : 'Replace each [X] with a real detail before you send it. You can edit the text right here.';
        say(msg2, `${r.left} of ${$('[data-limit]').textContent} left today`);
        showGaps(r.summary);
        root.dataset.stage = 'written';
        track('tailor', withSurface({ step: 'write', source: r.source, keywords: confirmed.length }));
      } catch (err) { say(msg2, (err as Error).message, true); }
      b.disabled = false;
    });

    // Keywords from the posting that the summary does not mention yet.
    function showGaps(summary: string) {
      const all = Array.from(kwList.querySelectorAll<HTMLInputElement>('input')).map((x) => x.value);
      const box = $('[data-gap]');
      if (!all.length) { box.hidden = true; return; }
      const text = summary.toLowerCase();
      const covered = (k: string) => {
        const t = k.toLowerCase();
        if (text.includes(t)) return true;
        const words = t.split(/\s+/).filter((w) => w.length > 3);
        const hit = words.filter((w) => text.includes(w.replace(/(es|s)$/, ''))).length;
        return words.length > 0 && hit * 2 >= words.length;
      };
      const missing = all.filter((k) => !covered(k));
      box.hidden = false;
      $('[data-gap-h]').textContent = missing.length
        ? `${all.length - missing.length} of ${all.length} posting keywords are in your summary. Not yet:`
        : `All ${all.length} posting keywords are in your summary.`;
      $('[data-gap-list]').innerHTML = missing.map((k) => `<span>${esc(k)}</span>`).join('');
      $('[data-gap-list]').hidden = !missing.length;
      root!.querySelector<HTMLElement>('.tl-gap-note')!.hidden = !missing.length;
    }

    // ---------- embed (extension side panel): collapsed sections and one action bar ----------
    const num = (x: number) => x.toLocaleString('en-US');
    function compact() {
      if (!embed) return;
      const hasPosting = posting.value.trim().length > 0;
      const pCollapsed = hasPosting && !postingOpen;
      $('[data-pbody]').hidden = pCollapsed;
      $('[data-psum]').hidden = !pCollapsed;
      $('[data-psum-text]').textContent = `${fromSite ? `From ${fromSite.replace(/^www\./, '')} · ` : ''}${num(posting.value.length)} characters`;
      const aCollapsed = !aboutOpen && title.value.trim().length > 0;
      $('[data-abody]').hidden = aCollapsed;
      $('[data-asum]').hidden = !aCollapsed;
      const k = skills.value.split(',').filter((x) => x.trim()).length;
      $('[data-asum-text]').textContent = [title.value.trim(), level[0].toUpperCase() + level.slice(1), k ? `${k} skill${k > 1 ? 's' : ''}` : ''].filter(Boolean).join(' · ');
      syncBar();
    }
    const barMain = $<HTMLButtonElement>('[data-bar-main]');
    const barAlt = $<HTMLButtonElement>('[data-bar-alt]');
    const btnExtract = $<HTMLButtonElement>('[data-extract]');
    const btnWrite = $<HTMLButtonElement>('[data-write]');
    const btnCopy = $<HTMLButtonElement>('[data-copy]');
    // Writes only on change, so the MutationObserver below does not loop.
    const put = <K extends 'textContent' | 'disabled' | 'hidden'>(el: HTMLElement, k: K, v: HTMLButtonElement[K]) => {
      if ((el as HTMLButtonElement)[k] !== v) (el as HTMLButtonElement)[k] = v;
    };
    function syncBar() {
      const stage = root!.dataset.stage;
      put(barAlt, 'hidden', stage !== 'written');
      put(barAlt, 'disabled', btnWrite.disabled);
      let label = 'Find keywords';
      let disabled = btnExtract.disabled || !posting.value.trim();
      if (stage === 'written') { label = btnCopy.textContent || 'Copy summary'; disabled = false; }
      else if (stage === 'keywords') { label = btnWrite.disabled ? 'Writing...' : 'Write my summary'; disabled = btnWrite.disabled; }
      else if (btnExtract.disabled && posting.value.trim()) label = 'Reading the posting...';
      put(barMain, 'textContent', label);
      put(barMain, 'disabled', disabled);
      barMain.classList.toggle('is-copied', label === 'Copied!'); // global .btn.is-copied style
    }
    function needTitle() {
      if (title.value.trim()) return false;
      aboutOpen = true;
      compact();
      title.focus();
      say(msg2, 'Add the job title you are applying for first.', true);
      return true;
    }
    if (embed) {
      $('[data-bar]').hidden = false;
      barMain.addEventListener('click', () => {
        const stage = root!.dataset.stage;
        if (stage === 'written') btnCopy.click();
        else if (stage === 'keywords') { if (!needTitle()) btnWrite.click(); }
        else btnExtract.click();
      });
      barAlt.addEventListener('click', () => { if (!needTitle()) btnWrite.click(); });
      $('[data-psum-edit]').addEventListener('click', () => { postingOpen = true; compact(); posting.focus(); });
      $('[data-asum-edit]').addEventListener('click', () => { aboutOpen = true; compact(); title.focus(); });
      posting.addEventListener('input', compact);
      [title, skills].forEach((el) => el.addEventListener('input', syncBar));
      new MutationObserver(syncBar).observe(root, { subtree: true, attributes: true, attributeFilter: ['disabled', 'hidden', 'data-stage'], childList: true, characterData: true });
      compact();
    }

    $('[data-copy]').addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText($('[data-text]').innerText.trim()); } catch { /* clipboard unavailable */ }
      b.textContent = 'Copied!'; setTimeout(() => (b.textContent = 'Copy summary'), 1400);
      track('copy', withSurface({ tool: 'tailor' }));
    });
  }
</script>
