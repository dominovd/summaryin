---
import Base from '../../layouts/Base.astro';
import jobs from '../../data/jobDescriptions.json';
import Faq from '../../components/Faq.astro';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import { ROLE_GROUPS, ROLES } from '../../data/roles';
import { SITE } from '../../data/site';

type JD = { name: string; titles: string[]; duties: { core: string[]; entry: string[]; senior: string[] } };
const J = jobs as Record<string, JD>;
const groups = ROLE_GROUPS.map((g) => ({
  name: g.name,
  roles: g.slugs.filter((s) => J[s]).map((slug) => {
    const r = ROLES.find((x) => x.slug === slug)!;
    const d = J[slug].duties;
    return { slug, name: J[slug].name, first: d.core[0], count: d.core.length + d.entry.length + d.senior.length, summary: r.pages.s };
  }),
})).filter((g) => g.roles.length);
const total = Object.keys(J).length;
const lines = Object.values(J).reduce((n, j) => n + j.duties.core.length + j.duties.entry.length + j.duties.senior.length, 0);
const search = ROLES.filter((r) => r.pages.d).map((r) => ({ slug: r.slug, name: r.name, synonyms: r.synonyms }));
const demo = { duties: J.retail.duties.core.slice(0, 4), titles: J.retail.titles.slice(0, 3) };
const parts = (t: string) => t.split(/(\[[^\]]+\])/g).filter(Boolean);

const description =
  'Job description examples for a resume, by profession. Tick the duties you performed and copy a finished work-experience block, with power verbs and format tips.';

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Job description examples for a resume',
  itemListElement: groups.flatMap((g) => g.roles).map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${r.name} job description for resume`,
    url: new URL(`/job-description/${r.slug}/`, SITE.url).href,
  })),
};

const faq = [
  {
    q: 'What is a job description on a resume?',
    a: 'It is the group of bullet points under a job title in your work-experience section. The strongest version does more than list routine duties. It shows the type of work, the tools used, the size of the workload, and a result when one is available.',
  },
  {
    q: 'How many duties should I list for each job?',
    a: 'Start with four to six bullets for your most recent role and three to four for older positions. Keep the duties that match the job you want, and remove repeated or less relevant tasks.',
  },
  {
    q: 'Can I copy these job descriptions exactly?',
    a: 'Use them as editable starting points. Select only duties you actually performed, replace every bracket with a true detail, and adjust the tools and terminology to match your workplace.',
  },
  {
    q: 'What is the difference between a resume summary and a job description?',
    a: 'A resume summary is a short introduction at the top of the document. A job description sits under one employer and explains what you did in that specific role. The summary gives the overview, while the experience bullets provide the evidence.',
  },
];
---

<Base title="Job Description Examples for a Resume" description={description}>
  <BreadcrumbJsonLd items={[{ name: 'Home', href: '/' }, { name: 'Job descriptions', href: '/job-description/' }]} />
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />

  <section class="hub-hero">
    <div class="container jd-head">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <span>Job descriptions</span></nav>
        <h1>Job Description Examples for a Resume</h1>
        <p class="lead">Pick your role, tick the duties you actually performed, and copy a finished work-experience block.</p>
        <p class="review-line">Reviewed {SITE.contentLastReviewed.replace(/^(\w{3})\w*/, '$1')} by the SummaryIn editorial team · <a href="/editorial-policy/">How we review</a></p>
      </div>
      <dl class="jd-stats">
        <div><dt>Professions</dt><dd>{total}</dd></div>
        <div><dt>Duty lines</dt><dd>{lines}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section jd-lib" data-jd>
    <script type="application/json" data-jd-json set:html={JSON.stringify(search)} />
    <div class="container">
      <div class="jd-finder">
        <label class="visually-hidden" for="jd-q">Search a job title</label>
        <input id="jd-q" class="jd-q" type="search" placeholder="Search a job title, e.g. nurse aide, babysitter, CDL" autocomplete="off" />
        <div class="jd-chips" role="group" aria-label="Filter by group">
          <button type="button" data-g="" aria-pressed="true">All</button>
          {groups.map((g) => <button type="button" data-g={g.name} aria-pressed="false">{g.name}</button>)}
        </div>
      </div>
      {groups.map((g) => (
        <div class="jd-sector" data-sector={g.name}>
          <h2 class="jd-sector-title">{g.name}</h2>
          <div class="jd-grid">
            {g.roles.map((r) => (
              <article class="jd-card" data-slug={r.slug}>
                <a class="jd-main" href={`/job-description/${r.slug}/`}>
                  <span class="jd-top"><b>{r.name} job description for resume</b><small>{r.count} duty lines</small></span>
                  <span class="jd-first">{parts(r.first).map((x) => /^\[[^\]]+\]$/.test(x) ? <mark>{x}</mark> : x)}</span>
                </a>
                <span class="jd-links">
                  <a href={`/job-description/${r.slug}/`}>Pick duties →</a>
                  {r.summary && <a class="jd-sum" href={`/resume-summary/${r.slug}/`}>Summary examples</a>}
                </span>
              </article>
            ))}
          </div>
        </div>
      ))}
      <p class="jd-none muted" data-jd-none hidden>No duty page for this role yet. The <a href="/resume-bullet-points/">bullet point generator</a> works for any job.</p>
    </div>
  </section>

  <section class="section section-subtle" aria-labelledby="demo-heading">
    <div class="container">
      <h2 id="demo-heading">How the duty picker works</h2>
      <p class="muted demo-lead">Every role page has entry, core, and senior duty lines. Here is a short version with four Retail lines.</p>
      <div class="demo" data-demo>
        <div class="demo-l">
          <h3>Retail · core duties</h3>
          <p class="muted">Tick what you actually did.</p>
          {demo.duties.map((d, i) => (
            <label class="demo-row"><input type="checkbox" data-i={i} checked={i < 3} /><span>{d}</span></label>
          ))}
        </div>
        <div class="demo-r">
          <div class="demo-hd">
            <b data-demo-n>3 selected</b>
            <div class="demo-fmt" role="group" aria-label="Marker">
              {['Bullet', 'Dash', 'Plain'].map((f, i) => <button type="button" data-f={f} aria-pressed={i === 0 ? 'true' : 'false'}>{f}</button>)}
            </div>
          </div>
          <div class="demo-titles" role="group" aria-label="Job title">
            {demo.titles.map((t, i) => <button type="button" data-t={t} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>)}
          </div>
          <div class="demo-blk" data-demo-blk aria-live="polite"></div>
          <p class="muted demo-note">Replace each [X] with your real number. Nothing you tick is sent anywhere.</p>
          <div class="demo-acts">
            <button type="button" class="btn btn-primary btn-sm" data-demo-copy>Copy block</button>
            <a class="btn btn-ghost btn-sm" href="/job-description/retail/">All Retail duties →</a>
          </div>
        </div>
      </div>
      <script type="application/json" data-demo-json set:html={JSON.stringify(demo.duties)} />
    </div>
  </section>

  <section class="section" aria-labelledby="include-heading">
    <div class="container">
      <h2 id="include-heading">What to include under each job</h2>
      <p class="muted inc-lead">Start with the work most relevant to the position you want. Routine duties can stay, but they should not crowd out judgment, ownership, or results.</p>
      <ol class="inc">
        {['A clear action at the start of each line', 'The customers, patients, products, or process you supported', 'Relevant systems, equipment, or certifications', 'A count, percentage, dollar amount, or time saved when known'].map((t) => <li>{t}</li>)}
      </ol>
      <div class="ba">
        <h3>Turn a duty into useful evidence</h3>
        <div class="ba-row">
          <div class="ba-weak"><small>Too general</small>Responsible for helping customers and handling returns.</div>
          <div class="ba-better"><small>More specific</small>Handled [X]+ customer questions and returns per shift in [POS system], resolving routine issues without manager escalation.</div>
        </div>
      </div>
      <div class="vs">
        <div class="card"><h3>Job description</h3><p>Bullets under a specific employer. They show the work behind your claims. Write these first.</p><a href="/resume-bullet-points/">Check your own lines with the bullet builder →</a></div>
        <div class="card"><h3>Resume summary</h3><p>Two or three sentences at the top that introduce your overall fit, shaped from your strongest bullets.</p><a href="/#generator">Build a resume summary →</a></div>
      </div>
    </div>
  </section>

  <Faq items={faq} heading="Job description FAQ" />
</Base>

<style>
  .hub-hero { padding: 40px 0 0; }
  .jd-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px 32px; flex-wrap: wrap; }
  .crumbs { font-size: 0.88rem; color: var(--ink-muted); margin-bottom: 14px; }
  .crumbs a { color: var(--ink-muted); }
  .hub-hero .lead { max-width: 40rem; }
  .review-line { font-size: 0.9rem; color: var(--ink-muted); margin: 0; }
  .jd-stats { display: flex; gap: 22px; margin: 0; }
  .jd-stats div { display: flex; flex-direction: column-reverse; }
  .jd-stats dt { font-size: 0.82rem; color: var(--ink-muted); }
  .jd-stats dd { margin: 0; font-size: 1.6rem; font-weight: 800; color: var(--ink); }
  .jd-lib { padding-top: 24px; }
  .jd-finder { border: 1px solid var(--border); background: var(--bg-subtle); border-radius: var(--r-lg); padding: 14px; display: grid; gap: 12px; }
  .jd-q { font: inherit; width: 100%; padding: 11px 14px; border: 1px solid var(--border-strong); border-radius: var(--r-sm); background: #fff; }
  .jd-q:focus { outline: 2px solid var(--primary); outline-offset: 1px; }
  .jd-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .jd-chips button { font: inherit; font-size: 0.88rem; border: 1px solid var(--border); background: #fff; color: var(--ink-soft); border-radius: 999px; padding: 6px 12px; cursor: pointer; white-space: nowrap; }
  .jd-chips button[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .jd-sector { margin-top: 26px; }
  .jd-sector-title { font-size: 0.8rem; font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 12px; }
  .jd-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 900px) { .jd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .jd-grid { grid-template-columns: 1fr; } .jd-chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; } }
  .jd-card { border: 1px solid var(--border); border-radius: var(--r-lg); background: #fff; display: flex; flex-direction: column; }
  .jd-card:hover { border-color: var(--primary-border); }
  .jd-main { display: flex; flex-direction: column; gap: 8px; padding: 16px 16px 8px; color: var(--ink); }
  .jd-main:hover { text-decoration: none; }
  .jd-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .jd-top b { font-size: 1rem; }
  .jd-top small { font-size: 0.78rem; color: var(--ink-muted); white-space: nowrap; }
  .jd-first { font-size: 0.9rem; line-height: 1.5; color: var(--ink-soft); border-left: 3px solid var(--border); padding-left: 10px; }
  .jd-first mark { background: #fff3b8; border-bottom: 1px dashed #b58b00; border-radius: 3px; padding: 0 1px; color: inherit; }
  .jd-links { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; padding: 4px 16px 14px; margin-top: auto; font-size: 0.88rem; }
  .jd-links a { font-weight: 650; }
  .jd-links .jd-sum { font-weight: 500; }
  .jd-none { margin-top: 20px; }
  .demo-lead { margin: 0 0 16px; }
  .demo { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); border: 1px solid var(--border); border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow-card); }
  @media (max-width: 820px) { .demo { grid-template-columns: 1fr; } }
  .demo-l { padding: 20px; }
  .demo-l h3 { font-size: 1rem; margin: 0 0 2px; }
  .demo-l p { margin: 0 0 10px; font-size: 0.9rem; }
  .demo-row { display: grid; grid-template-columns: 20px 1fr; gap: 10px; padding: 10px 0; border-top: 1px solid var(--border); font-size: 0.95rem; color: var(--ink-soft); cursor: pointer; }
  .demo-row input { width: 18px; height: 18px; margin: 2px 0 0; accent-color: var(--primary); }
  .demo-r { padding: 20px; background: var(--bg-subtle); border-radius: 0 var(--r-lg) var(--r-lg) 0; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  @media (max-width: 820px) { .demo-r { border-radius: 0 0 var(--r-lg) var(--r-lg); } }
  .demo-hd { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.9rem; }
  .demo-fmt, .demo-titles { display: flex; flex-wrap: wrap; gap: 6px; }
  .demo-fmt button, .demo-titles button { font: inherit; font-size: 0.85rem; border: 1px solid var(--border); background: #fff; color: var(--ink-soft); border-radius: 999px; padding: 5px 11px; cursor: pointer; }
  .demo-fmt button[aria-pressed="true"], .demo-titles button[aria-pressed="true"] { background: var(--primary-soft); border-color: var(--primary); color: var(--primary); font-weight: 650; }
  .demo-blk { background: #fff; border: 1px solid var(--border); border-radius: var(--r-md); padding: 14px 16px; font-size: 0.94rem; line-height: 1.6; color: var(--ink); min-height: 150px; }
  .demo-blk :global(div) { padding-left: 16px; text-indent: -16px; }
  .demo-blk :global(.jt) { font-weight: 700; text-indent: 0; padding: 0; margin-bottom: 4px; }
  .demo-blk :global(mark) { background: #fff3b8; border-radius: 3px; padding: 0 2px; color: inherit; }
  .demo-note { font-size: 0.84rem; margin: 0; }
  .demo-acts { display: flex; gap: 8px; flex-wrap: wrap; }
  .inc-lead { max-width: 62ch; }
  .inc { list-style: none; counter-reset: inc; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin: 16px 0 0; padding: 0; }
  @media (max-width: 820px) { .inc { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .inc li { counter-increment: inc; border: 1px solid var(--border); border-radius: var(--r-md); padding: 14px; font-size: 0.93rem; color: var(--ink-soft); }
  .inc li::before { content: counter(inc); display: block; font-size: 1.35rem; font-weight: 800; color: var(--primary); margin-bottom: 4px; }
  .ba { border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden; margin-top: 16px; }
  .ba h3 { padding: 12px 16px 0; font-size: 1rem; margin: 0; }
  .ba-row { display: grid; grid-template-columns: 1fr 1fr; margin-top: 10px; border-top: 1px solid var(--border); }
  @media (max-width: 600px) { .ba-row { grid-template-columns: 1fr; } }
  .ba-row div { padding: 10px 16px; font-size: 0.93rem; line-height: 1.5; }
  .ba-weak { background: #fef2f2; color: #7f1d1d; }
  .ba-better { background: var(--success-soft); color: #14532d; }
  .ba-row small { display: block; font-size: 0.7rem; font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 3px; opacity: 0.75; }
  .vs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
  @media (max-width: 600px) { .vs { grid-template-columns: 1fr; } }
  .vs h3 { font-size: 1rem; margin: 0 0 6px; }
  .vs p { color: var(--ink-soft); font-size: 0.95rem; margin: 0 0 8px; }
  .vs a { font-weight: 650; font-size: 0.93rem; }
</style>

<script>
  import { track } from '@vercel/analytics';

  const root = document.querySelector<HTMLElement>('[data-jd]');
  if (root) {
    const roles: { slug: string; name: string; synonyms: string[] }[] = JSON.parse(root.querySelector('[data-jd-json]')!.textContent || '[]');
    const q = root.querySelector<HTMLInputElement>('#jd-q')!;
    let group = '';
    const match = (t: string) => {
      let best = '', score = 0;
      for (const r of roles) for (const c of [r.name.toLowerCase(), ...r.synonyms]) {
        const s = t === c ? 100 + c.length : c.length >= 3 && t.includes(c) ? c.length : 0;
        if (s > score) { score = s; best = r.slug; }
      }
      return best;
    };
    function apply() {
      const t = q.value.toLowerCase().trim(); const m = match(t); let any = 0;
      root!.querySelectorAll<HTMLElement>('[data-sector]').forEach((sec) => {
        let n = 0;
        sec.querySelectorAll<HTMLElement>('.jd-card').forEach((c) => {
          const r = roles.find((x) => x.slug === c.dataset.slug);
          const ok = (!group || sec.dataset.sector === group) && (!t || m === c.dataset.slug || !!r && [r.name.toLowerCase(), ...r.synonyms].some((x) => x.includes(t)));
          c.hidden = !ok; if (ok) n++;
        });
        sec.hidden = n === 0; any += n;
      });
      root!.querySelector<HTMLElement>('[data-jd-none]')!.hidden = any > 0;
    }
    q.addEventListener('input', apply);
    root.querySelector('.jd-chips')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (!b) return;
      group = b.dataset.g || '';
      root!.querySelectorAll('.jd-chips button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    });
  }

  const demo = document.querySelector<HTMLElement>('[data-demo]');
  if (demo) {
    const duties: string[] = JSON.parse(document.querySelector('[data-demo-json]')!.textContent || '[]');
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));
    const mark = (s: string) => esc(s).replace(/\[([^\]]+)\]/g, '<mark>[$1]</mark>');
    const pressed = (sel: string) => demo.querySelector<HTMLElement>(`${sel} [aria-pressed="true"]`)!;
    function selected() { return Array.from(demo!.querySelectorAll<HTMLInputElement>('input:checked')).map((x) => duties[Number(x.dataset.i)]); }
    function text() {
      const p = { Bullet: '• ', Dash: '- ', Plain: '' }[pressed('.demo-fmt').dataset.f as 'Bullet'];
      return [`${pressed('.demo-titles').dataset.t} | [Store name], [City] | [Start] to [End]`, ...selected().map((d) => p + d)];
    }
    function render() {
      const sel = selected(); const lines = text();
      demo!.querySelector('[data-demo-n]')!.textContent = `${sel.length} selected`;
      demo!.querySelector('[data-demo-blk]')!.innerHTML = `<div class="jt">${mark(lines[0])}</div>` + (sel.length ? lines.slice(1).map((l) => `<div>${mark(l)}</div>`).join('') : '<div class="muted">Tick at least one duty.</div>');
    }
    demo.addEventListener('change', render);
    demo.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.demo-fmt button, .demo-titles button');
      if (b) { b.parentElement!.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); render(); return; }
      const c = (e.target as HTMLElement).closest<HTMLElement>('[data-demo-copy]');
      if (c) {
        try { await navigator.clipboard.writeText(text().join('\n')); } catch { /* clipboard unavailable */ }
        c.textContent = 'Copied!'; setTimeout(() => { c.textContent = 'Copy block'; }, 1400);
        track('copy', { tool: 'jd_demo' });
      }
    });
    render();
  }
</script>
