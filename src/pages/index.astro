---
import Base from '../layouts/Base.astro';
import Generator from '../components/Generator.astro';
import CopyBlock from '../components/CopyBlock.astro';
import CopyScript from '../components/CopyScript.astro';
import ProfessionGrid from '../components/ProfessionGrid.astro';
import EmailCapture from '../components/EmailCapture.astro';
import Faq from '../components/Faq.astro';
import RelatedKeywords from '../components/RelatedKeywords.astro';
import CtaBanner from '../components/CtaBanner.astro';
import professions from '../data/professions.json';

const cs = professions['customer-service'];

const popularChips = [
  { label: 'Customer Service', href: '/resume-summary/customer-service/' },
  { label: 'Project Manager', href: '/resume-summary/project-manager/' },
  { label: 'Nursing', href: '/resume-summary/nursing/' },
  { label: 'All professions', href: '/resume-summary/' },
];

const faq = [
  {
    q: 'What is a resume summary?',
    a: 'A resume summary is a 2–3 sentence statement at the top of your resume that highlights your experience level, strongest skills, and one measurable achievement. It replaces the outdated "objective" and tells a recruiter in seconds why you fit the role.',
  },
  {
    q: 'Is this generator really free?',
    a: 'Yes — completely free, no sign-up, no word limits. Everything runs in your browser: your input is never sent to a server or stored anywhere.',
  },
  {
    q: 'Resume summary vs. objective — which should I use?',
    a: 'Use a summary. It focuses on what you offer the employer, while an objective focuses on what you want. The only common exception is a dramatic career change, where a short objective can explain the pivot — but a skills-focused summary usually still wins.',
  },
  {
    q: 'How long should a professional summary be?',
    a: 'Two to three sentences, roughly 40–60 words. Lead with your title and years of experience, follow with your core skills, and close with one number that proves impact.',
  },
  {
    q: 'Can I use the generated summary on LinkedIn?',
    a: 'Yes — it works as the opening lines of your LinkedIn About section. For LinkedIn, consider expanding it with a sentence about what you\'re looking for, since the format allows more space than a resume.',
  },
];

const relatedKeywords = [
  'professional summary for resume',
  'resume summary examples',
  'what is a resume summary',
  'summary for resume',
  'good summary for resume',
  'professional summary for cv',
  'resume summary generator',
  'brief cv summary',
];
---

<Base
  title="Free Resume Summary Generator"
  description="Create a job-ready professional summary in seconds — free, no sign-up, private in your browser. Then copy it, edit it, and make it yours."
>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="container">
      <p class="hero-kicker">Free · No sign-up</p>
      <h1>Free Resume Summary Generator</h1>
      <p class="lead">
        Create a job-ready professional summary in seconds — then copy, edit, and make it yours.
      </p>
      <div class="badges hero-badges">
        <span class="badge">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.6"/><path d="M5 8.2l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          100% free
        </span>
        <span class="badge">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.6"/><path d="M5 8.2l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Private — runs in your browser
        </span>
        <span class="badge">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.6"/><path d="M5 8.2l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          4 tailored options
        </span>
      </div>
    </div>
  </section>

  <!-- 2. Tool -->
  <section class="tool-section">
    <div class="container">
      <Generator
        defaultRole="Customer Service Representative"
        skills={['Communication', 'CRM', 'Problem solving', 'Order management', 'Teamwork', 'Time management']}
        defaultSkills={['Communication', 'CRM', 'Problem solving']}
      />
      <div class="popular-row">
        <span class="muted popular-label">Popular:</span>
        {popularChips.map((c) => <a class="chip" href={c.href}>{c.label}</a>)}
      </div>
    </div>
  </section>

  <!-- 3. Copyable examples -->
  <section class="section" aria-labelledby="examples-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="examples-heading">Professional summary examples you can copy</h2>
        <p class="muted">
          Three levels of the same career — see how the summary grows with experience.
          Want your profession? <a href="/resume-summary/">Browse examples by role</a>.
        </p>
      </div>
      <div class="grid grid-3">
        <CopyBlock label="Entry-level" icon="entry" paragraphs={cs.examples.entry[0].paragraphs} />
        <CopyBlock label="Mid-career" icon="mid" paragraphs={cs.examples.mid[0].paragraphs} />
        <CopyBlock label="Senior" icon="senior" paragraphs={cs.examples.senior[0].paragraphs} />
      </div>
    </div>
  </section>

  <!-- 4. Profession grid -->
  <ProfessionGrid />

  <!-- 5. How-to + power words -->
  <section class="section section-subtle" id="power-words" aria-labelledby="howto-heading">
    <div class="container">
      <div class="grid grid-2 howto-grid">
        <div class="card">
          <h2 id="howto-heading" class="howto-title">Build a stronger summary</h2>
          <ol class="steps">
            <li>
              <h3>Lead with your role</h3>
              <p class="muted">Start with your job title and years of experience — it's the first thing a screener matches against the posting.</p>
            </li>
            <li>
              <h3>Add proof with numbers</h3>
              <p class="muted">One metric beats five adjectives: satisfaction score, time saved, revenue, error rate — pick the number the role cares about.</p>
            </li>
            <li>
              <h3>Match the job's language</h3>
              <p class="muted">Mirror keywords from the job description — both ATS filters and humans scan for the exact terms they wrote.</p>
            </li>
          </ol>
        </div>
        <div class="card">
          <h2 class="howto-title">Power words that carry weight</h2>
          <div class="table-wrap">
            <table class="data">
              <thead>
                <tr><th scope="col">Word</th><th scope="col">How to use it</th></tr>
              </thead>
              <tbody>
                {cs.powerWords.map((w) => (
                  <tr><td>{w.word}</td><td>{w.usage}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="table-note muted">More power words on every <a href="/resume-summary/">profession page</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Email capture -->
  <EmailCapture />

  <!-- 7. FAQ (+ FAQPage schema) -->
  <Faq items={faq} />

  <!-- 8. Related searches -->
  <RelatedKeywords keywords={relatedKeywords} />

  <!-- 9. Bridge CTA to resume builder -->
  <CtaBanner />

  <CopyScript />
</Base>

<style>
  .hero { padding: 56px 0 8px; }
  .hero-kicker {
    color: var(--primary);
    font-weight: 750;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }
  .hero-badges { margin-top: 18px; }

  .tool-section { padding: 28px 0 12px; }
  .popular-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
  }
  .popular-label { font-size: 0.92rem; margin-right: 4px; }

  .howto-grid { align-items: stretch; }
  .howto-title { font-size: 1.25rem; margin-bottom: 16px; }
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
  }
  .steps li {
    counter-increment: step;
    position: relative;
    padding-left: 46px;
    margin-bottom: 18px;
  }
  .steps li:last-child { margin-bottom: 0; }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 2px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1.6px solid var(--primary);
    color: var(--primary);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
  }
  .steps h3 { margin-bottom: 2px; font-size: 1rem; }
  .steps p { margin: 0; font-size: 0.94rem; }
  .table-note { font-size: 0.88rem; margin: 12px 0 0; }
</style>
