---
import Base from '../layouts/Base.astro';
import Generator from '../components/Generator.astro';
import CopyBlock from '../components/CopyBlock.astro';
import CopyScript from '../components/CopyScript.astro';
import ProfessionGrid from '../components/ProfessionGrid.astro';
import EmailCapture from '../components/EmailCapture.astro';
import Faq from '../components/Faq.astro';
import RelatedKeywords from '../components/RelatedKeywords.astro';
import CtaBanner from '../components/CtaBanner.astro';
import professions from '../data/professions.json';

const cs = professions['customer-service'];

const popularChips = [
  { label: 'Customer Service', href: '/resume-summary/customer-service/' },
  { label: 'Project Manager', href: '/resume-summary/project-manager/' },
  { label: 'Nursing', href: '/resume-summary/nursing/' },
  { label: 'All professions', href: '/resume-summary/' },
];

const faq = [
  {
    q: 'What is a resume summary?',
    a: 'A resume summary is a short statement at the top of your resume, usually two or three sentences. It highlights your experience, strongest skills, and one result you are proud of. A recruiter should be able to see why you fit the role in a few seconds.',
  },
  {
    q: 'Is this generator really free?',
    a: 'Yes. It is completely free, with no sign-up or word limit. The generator works in your browser, so we do not send or store what you type.',
  },
  {
    q: 'Resume summary or objective: which should I use?',
    a: 'A summary works better for most people because it shows what you can offer an employer. An objective focuses on what you want. If you are making a major career change, one short sentence can explain the move, but your skills should still do most of the talking.',
  },
  {
    q: 'How long should a professional summary be?',
    a: 'Aim for two or three sentences, or about 40 to 60 words. Start with your role and experience, mention the skills that matter for the job, and finish with a result you can prove.',
  },
  {
    q: 'Can I use the generated summary on LinkedIn?',
    a: 'Yes. It can become the opening of your LinkedIn About section. LinkedIn gives you more space, so you can add a sentence about the work you enjoy or the opportunity you want next.',
  },
];

const relatedKeywords = [
  'professional summary for resume',
  'resume summary examples',
  'what is a resume summary',
  'summary for resume',
  'good summary for resume',
  'professional summary for cv',
  'resume summary generator',
  'brief cv summary',
];
---

<Base
  title="Free Resume Summary Generator"
  description="Write a clear professional summary in seconds. It is free, requires no sign-up, and works privately in your browser."
>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="container">
      <p class="hero-kicker">Free · No sign-up</p>
      <h1>Free Resume Summary Generator</h1>
      <p class="lead">
        Write a clear professional summary in seconds. Copy a version you like, adjust the details, and add it to your resume.
      </p>
      <div class="badges hero-badges">
        <span class="badge">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.6"/><path d="M5 8.2l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          100% free
        </span>
        <span class="badge">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.6"/><path d="M5 8.2l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Your details stay on this device
        </span>
        <span class="badge">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.6"/><path d="M5 8.2l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          4 tailored options
        </span>
      </div>
    </div>
  </section>

  <!-- 2. Tool -->
  <section class="tool-section" id="generator">
    <div class="container">
      <Generator
        defaultRole="Customer Service Representative"
        skills={['Communication', 'CRM', 'Problem solving', 'Order management', 'Teamwork', 'Time management']}
        defaultSkills={['Communication', 'CRM', 'Problem solving']}
      />
      <div class="popular-row">
        <span class="muted popular-label">Popular:</span>
        {popularChips.map((c) => <a class="chip" href={c.href}>{c.label}</a>)}
      </div>
    </div>
  </section>

  <!-- 3. Copyable examples -->
  <section class="section" aria-labelledby="examples-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="examples-heading">Professional summary examples you can copy</h2>
        <p class="muted">
          See how the same summary changes as your experience grows.
          Want your profession? <a href="/resume-summary/">Browse examples by role</a>.
        </p>
      </div>
      <div class="grid grid-3">
        <CopyBlock label="Entry-level" icon="entry" paragraphs={cs.examples.entry[0].paragraphs} />
        <CopyBlock label="Mid-career" icon="mid" paragraphs={cs.examples.mid[0].paragraphs} />
        <CopyBlock label="Senior" icon="senior" paragraphs={cs.examples.senior[0].paragraphs} />
      </div>
    </div>
  </section>

  <!-- 4. Profession grid -->
  <ProfessionGrid />

  <!-- 5. How-to + power words -->
  <section class="section section-subtle" id="power-words" aria-labelledby="howto-heading">
    <div class="container">
      <div class="grid grid-2 howto-grid">
        <div class="card">
          <h2 id="howto-heading" class="howto-title">Build a stronger summary</h2>
          <ol class="steps">
            <li>
              <h3>Lead with your role</h3>
              <p class="muted">Start with your job title and years of experience. That is the first thing most recruiters compare with the posting.</p>
            </li>
            <li>
              <h3>Add proof with numbers</h3>
              <p class="muted">A real number says more than a list of adjectives. Use a satisfaction score, time saved, revenue, error rate, or another result the employer will understand.</p>
            </li>
            <li>
              <h3>Match the job's language</h3>
              <p class="muted">Use the same terms you see in the job description. Recruiters and ATS filters both look for that familiar language.</p>
            </li>
          </ol>
        </div>
        <div class="card">
          <h2 class="howto-title">Words that make your experience specific</h2>
          <div class="table-wrap">
            <table class="data">
              <thead>
                <tr><th scope="col">Word</th><th scope="col">How to use it</th></tr>
              </thead>
              <tbody>
                {cs.powerWords.map((w) => (
                  <tr><td>{w.word}</td><td>{w.usage}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="table-note muted">More power words on every <a href="/resume-summary/">profession page</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Email capture -->
  <EmailCapture />

  <!-- 7. FAQ (+ FAQPage schema) -->
  <Faq items={faq} />

  <!-- 8. Related searches -->
  <RelatedKeywords keywords={relatedKeywords} />

  <!-- 9. Bridge CTA to resume builder -->
  <CtaBanner />

  <CopyScript />
</Base>

<style>
  .hero { padding: 56px 0 8px; }
  .hero-kicker {
    color: var(--primary);
    font-weight: 750;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }
  .hero-badges { margin-top: 18px; }

  .tool-section { padding: 28px 0 12px; }
  .popular-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
  }
  .popular-label { font-size: 0.92rem; margin-right: 4px; }

  .howto-grid { align-items: stretch; }
  .howto-title { font-size: 1.25rem; margin-bottom: 16px; }
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
  }
  .steps li {
    counter-increment: step;
    position: relative;
    padding-left: 46px;
    margin-bottom: 18px;
  }
  .steps li:last-child { margin-bottom: 0; }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 2px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1.6px solid var(--primary);
    color: var(--primary);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
  }
  .steps h3 { margin-bottom: 2px; font-size: 1rem; }
  .steps p { margin: 0; font-size: 0.94rem; }
  .table-note { font-size: 0.88rem; margin: 12px 0 0; }
</style>
