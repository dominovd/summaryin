---
/**
 * Format-and-tool page for the bullet-points cluster.
 * Head terms: "resume bullet point generator", "resume bullet points",
 * "bullet points for resume", "how many bullet points per job on resume",
 * "resume bullet point format".
 */
import Base from '../../layouts/Base.astro';
import BulletBuilder from '../../components/BulletBuilder.astro';
import CopyBlock from '../../components/CopyBlock.astro';
import CopyScript from '../../components/CopyScript.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import Faq from '../../components/Faq.astro';
import RelatedKeywords from '../../components/RelatedKeywords.astro';
import RoleCatalog from '../../components/RoleCatalog.astro';
import AppJsonLd from '../../components/AppJsonLd.astro';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import { SITE } from '../../data/site';
import EditorialNote from '../../components/EditorialNote.astro';
import ArticleJsonLd from '../../components/ArticleJsonLd.astro';

const formatRules = [
  { rule: 'How many per job', answer: 'Four to six on your current role and three to four on older ones is a useful starting point. Keep only the lines that help explain your fit for the next job.' },
  { rule: 'Length', answer: 'One to two lines. If a bullet wraps to a third line, it holds two ideas and should be split.' },
  { rule: 'Tense', answer: 'Past tense for old jobs, present tense for the one you hold now. Stay consistent inside each role.' },
  { rule: 'First word', answer: 'An action verb usually makes the line easier to scan. Openers such as "Responsible for" and "Duties included" add little detail.' },
  { rule: 'Punctuation', answer: 'Periods or no periods, but pick one and use it on every bullet in the document.' },
  { rule: 'Pronouns', answer: 'No I, me, or my. The resume is understood to be about you.' },
  { rule: 'Marker', answer: 'Use a round bullet or a simple dash. Plain markers are easier to keep consistent across resume formats.' },
  { rule: 'Numbers', answer: 'Add a count, percent, dollar figure, or time saved when it is true and helps explain the scale of your work.' },
];

const beforeAfter = [
  {
    label: 'Weak: duty only',
    icon: 'entry' as const,
    paragraphs: ['Responsible for answering customer emails and phone calls on a daily basis.'],
  },
  {
    label: 'Better: adds volume',
    icon: 'mid' as const,
    paragraphs: ['Handled 60+ customer emails and calls per day across billing and shipping issues.'],
  },
  {
    label: 'Strong: adds the result',
    icon: 'senior' as const,
    paragraphs: ['Handled 60+ customer contacts per day and resolved 82% at first contact, cutting escalations to the billing team by a quarter.'],
  },
];

const faq = [
  {
    q: 'How many bullet points should I have per job on a resume?',
    a: 'Four to six bullets for your current or most recent job and three to four for older ones is a practical starting point. Keep the details most relevant to the role you want. If an entry needs eight or more lines, check whether it combines two positions or repeats similar work.',
  },
  {
    q: 'Do you put periods after bullet points on a resume?',
    a: 'Either is correct. What matters is consistency: if the first bullet ends with a period, every bullet in the document should. Periods read better when your bullets are full sentences, and no periods reads cleaner when they are short fragments.',
  },
  {
    q: 'What is the correct format for a resume bullet point?',
    a: 'Start with a past-tense action verb, state what you did, add how you did it, and close with the result. Keep it to one or two lines, drop pronouns, and put a number in the bullet whenever you have one. Avoid "Responsible for" as an opener.',
  },
  {
    q: 'Should resume bullet points be full sentences?',
    a: 'No. They are fragments that skip the subject: "Managed a team of six" rather than "I managed a team of six." Skip the article at the start when it reads naturally, keep the verb first, and do not chain two accomplishments into one line with "and also".',
  },
  {
    q: 'How do I write bullet points if my job had no measurable results?',
    a: 'Quantify the work instead of the outcome. Count what you handled: customers per shift, tickets per week, rooms cleaned, orders packed, students taught, files processed. Scope is a number too, and it tells a hiring manager how big your job actually was.',
  },
  {
    q: 'Is this bullet point generator free?',
    a: 'Yes, completely free with no sign-up and no limit on how many bullets you build. Everything runs in your browser, so the text you type is never sent to a server or stored anywhere.',
  },
];

const relatedKeywords = [
  'resume bullet points',
  'bullet points for resume',
  'resume bullet point generator',
  'how many bullet points per job on resume',
  'resume bullet point format',
  'how to write resume bullet points',
  'resume bullet point examples',
  'bullet points on resume examples',
];

---

<Base
  title="Resume Bullet Point Generator"
  description="Free resume bullet point generator: turn what you did into a formatted bullet with an action verb and a result, plus format rules and examples. No sign-up."
>
  <ArticleJsonLd
    headline="Resume Bullet Point Generator"
    description="Free resume bullet point generator with editable formats, examples, and practical writing rules."
    path="/resume-bullet-points/"
  />
  <AppJsonLd
    name="Resume Bullet Point Generator"
    description="Free browser tool that builds resume bullet points or improves a bullet you already have."
    path="/resume-bullet-points/"
  />
  <BreadcrumbJsonLd items={[{ name: 'Home', href: '/' }, { name: 'Bullet points', href: '/resume-bullet-points/' }]} />
  <section class="hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <span>Bullet points</span></nav>
      <h1>Resume Bullet Point Generator</h1>
      <p class="lead">Build a bullet from what you did, or paste one you already have and make it stronger. Free, no sign-up, runs in your browser.</p>
      <p class="hero-links">
        <span class="muted">Reviewed {SITE.contentLastReviewed.replace(/^(\w{3})\w*/, '$1')} by the SummaryIn editorial team · <a href="/editorial-policy/">How we review</a></span>
        <a href="#roles" class="hero-jump">Know your job? Start from ready bullets for 21 roles →</a>
      </p>
    </div>
  </section>

  <section class="tool-section">
    <div class="container">
      <BulletBuilder />
    </div>
  </section>

  <RoleCatalog heading="Ready-made bullets for your job" sections={['d']} id="roles" />

  <!-- Short answer to the highest-volume question in this cluster -->
  <section class="section" aria-labelledby="how-many-heading">
    <div class="container">
      <div class="answer-card card">
        <h2 id="how-many-heading">How many bullet points per job?</h2>
        <p>
          Start with four to six for your current or most recent role and three to four for older
          positions. Keep the lines that show relevant skills, workload, and results. If you cannot
          cut below eight, check whether the entry repeats similar duties or combines two different
          positions that would be clearer as separate entries.
        </p>
      </div>
    </div>
  </section>

  <!-- Before and after -->
  <section class="section" aria-labelledby="ba-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="ba-heading">The same bullet, three levels of strength</h2>
        <p class="muted">Each version adds one thing the one above it was missing.</p>
      </div>
      <div class="grid grid-3">
        {beforeAfter.map((b) => (
          <CopyBlock label={b.label} icon={b.icon} paragraphs={b.paragraphs} />
        ))}
      </div>
    </div>
  </section>

  <!-- Format rules table -->
  <section class="section section-subtle" aria-labelledby="format-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="format-heading">Resume bullet point format rules</h2>
        <p class="muted">A practical set of conventions for keeping the section clear and consistent.</p>
      </div>
      <div class="card">
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr><th scope="col">Rule</th><th scope="col">What to do</th></tr>
            </thead>
            <tbody>
              {formatRules.map((r) => (
                <tr><td>{r.rule}</td><td>{r.answer}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faq} heading="Resume bullet point FAQ" />
  <RelatedKeywords keywords={relatedKeywords} />
  <div class="container">
    <EditorialNote label="resume bullet point guide" />
  </div>
  {SITE.emailFormAction && <EmailCapture />}

  <CopyScript />
</Base>

<style>
  .hero { padding: 40px 0 4px; }
  .crumbs { font-size: 0.88rem; color: var(--ink-muted); margin-bottom: 14px; }
  .crumbs a { color: var(--ink-muted); }
  .hero .lead { max-width: 40rem; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 0.9rem; margin: 0; }
  .hero-jump { font-weight: 650; }
  .hero-kicker {
    color: var(--primary);
    font-weight: 750;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }
  .hero-badges { margin-top: 18px; }
  .tool-section { padding: 28px 0 12px; }
  .answer-card { max-width: 76ch; }
  .answer-card h2 { font-size: 1.25rem; }
  .answer-card p { margin: 0; color: var(--ink-soft); }
  .job-tile { padding: 15px 18px; font-weight: 650; color: var(--ink); font-size: 0.97rem; }
  a.job-tile:hover { text-decoration: none; border-color: var(--primary); box-shadow: var(--shadow-card); }
  .all-note { margin-top: 18px; font-size: 0.95rem; }
</style>
