---
/**
 * Static 404. Vercel serves this automatically for unmatched paths, so a
 * mistyped or retired URL lands on something useful instead of a bare error.
 * noindex: an error page should never enter the index.
 */
import Base from '../layouts/Base.astro';
import professions from '../data/professions.json';
import jobs from '../data/jobDescriptions.json';

const popular = Object.entries(professions)
  .slice(0, 6)
  .map(([slug, p]) => ({ slug, name: p.name }));

const counts = {
  summaries: Object.keys(professions).length,
  jobDescriptions: Object.keys(jobs).length,
};
---

<Base
  title="Page Not Found"
  description="That page does not exist. Browse resume summary examples, job description duties, or the free bullet point generator instead."
  yearInTitle={false}
  noindex
>
  <section class="section nf">
    <div class="container">
      <p class="nf-code">404</p>
      <h1>We could not find that page</h1>
      <p class="lead">
        The link may be mistyped or the page may have moved. Everything below still works.
      </p>

      <div class="nf-actions">
        <a class="btn btn-primary" href="/">Open the summary generator</a>
        <a class="btn btn-secondary" href="/resume-summary/">
          Browse {counts.summaries} professions
        </a>
      </div>

      <h2 class="nf-sub">Popular pages</h2>
      <div class="grid grid-3">
        <a class="nf-tile card" href="/resume-summary/">
          <span class="nf-tile-name">Resume summary examples</span>
          <span class="nf-tile-note muted">{counts.summaries} professions, entry to senior</span>
        </a>
        <a class="nf-tile card" href="/job-description/">
          <span class="nf-tile-name">Job description duties</span>
          <span class="nf-tile-note muted">{counts.jobDescriptions} roles, tick and copy</span>
        </a>
        <a class="nf-tile card" href="/resume-bullet-points/">
          <span class="nf-tile-name">Bullet point generator</span>
          <span class="nf-tile-note muted">Format rules and a line builder</span>
        </a>
      </div>

      <h2 class="nf-sub">Jump to a profession</h2>
      <ul class="nf-chips">
        {popular.map((p) => (
          <li><a class="chip" href={`/resume-summary/${p.slug}/`}>{p.name}</a></li>
        ))}
        <li><a class="chip" href="/resume-summary/">All professions</a></li>
      </ul>

      <p class="nf-contact muted">
        Followed a broken link from somewhere on this site?
        <a href="/contact/">Tell us where it was</a> and we will fix it.
      </p>
    </div>
  </section>
</Base>

<style>
  .nf { padding-top: 56px; max-width: 900px; }
  .nf-code {
    font-size: 0.85rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    color: var(--primary);
    margin-bottom: 10px;
  }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 24px 0 8px; }
  .nf-sub { font-size: 1.15rem; margin-top: 40px; margin-bottom: 14px; }
  .nf-tile { display: flex; flex-direction: column; gap: 4px; padding: 18px 20px; color: var(--ink); }
  a.nf-tile:hover { text-decoration: none; border-color: var(--primary); box-shadow: var(--shadow-card); }
  .nf-tile-name { font-weight: 700; font-size: 1rem; }
  .nf-tile-note { font-size: 0.88rem; }
  .nf-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; }
  .nf-contact { margin-top: 36px; font-size: 0.95rem; }
  .nf-contact a { margin-left: 4px; }
</style>
