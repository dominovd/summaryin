---
/**
 * The 11-block profession page template (playbook §template):
 *  1. H1 = exact keyword          2. Short answer
 *  3. Tool (preset generator)     4. Variants grid (examples by level)
 *  5. How-to adapt                6. Power-words table
 *  7. Visual guide                8. Related professions grid
 *  9. FAQ (+ schema)             10. Related keywords
 * 11. CTA + email capture
 * Add a profession = add one entry to src/data/professions.json.
 */
import Base from '../../layouts/Base.astro';
import Generator from '../../components/Generator.astro';
import ExampleLibrary from '../../components/ExampleLibrary.astro';
import AppJsonLd from '../../components/AppJsonLd.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import Faq from '../../components/Faq.astro';
import RelatedKeywords from '../../components/RelatedKeywords.astro';
import { SITE } from '../../data/site';
import SummaryAnatomy from '../../components/SummaryAnatomy.astro';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import ArticleJsonLd from '../../components/ArticleJsonLd.astro';
import EditorialNote from '../../components/EditorialNote.astro';
import professions from '../../data/professions.json';
import jobDescriptions from '../../data/jobDescriptions.json';
import { NO_EXPERIENCE_SLUGS } from '../../data/noExperience';

export function getStaticPaths() {
  return Object.keys(professions).map((job) => ({ params: { job } }));
}

const { job } = Astro.params;
const p = professions[job as keyof typeof professions];

/** A job-description page exists for this slug: the two pages link to each other. */
const hasJobDescription = job in jobDescriptions;

/** Acronym-safe label for mid-sentence use (CNA stays uppercase). */
const label = /^[A-Z0-9]+$/.test(p.name) ? p.name : p.name.toLowerCase();

const humanize = (slug: string) =>
  slug.split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join(' ');

const standardRelated = p.related.map((slug: string) => {
  const summary = (professions as Record<string, { name: string }>)[slug];
  const description = (jobDescriptions as Record<string, { name: string }>)[slug];
  return {
    slug,
    name: summary?.name ?? description?.name ?? humanize(slug),
    href: summary ? `/resume-summary/${slug}/` : description ? `/job-description/${slug}/` : '',
    live: Boolean(summary || description),
  };
});

const related = job === 'nursing'
  ? [
      { slug: 'cna', name: 'CNA', href: '/job-description/cna/', live: true },
      { slug: 'caregiver', name: 'Caregiver', href: '/job-description/caregiver/', live: true },
      { slug: 'phlebotomist', name: 'Phlebotomist', href: '/job-description/phlebotomist/', live: true },
      { slug: 'lpn', name: 'LPN duties', href: '/job-description/nursing/', live: true },
    ]
  : standardRelated;

const hasNoExperienceGuide = NO_EXPERIENCE_SLUGS.includes(job as typeof NO_EXPERIENCE_SLUGS[number]);
const relatedKeywords = p.relatedKeywords.map((keyword: string) => {
  if (hasNoExperienceGuide && /no experience|new grad/i.test(keyword)) {
    return { label: keyword, href: `/no-experience/${job}/` };
  }
  if (job === 'nursing' && /lpn resume summary/i.test(keyword)) {
    return { label: keyword, href: '/job-description/nursing/' };
  }
  return keyword;
});

const libItems = (['entry', 'mid', 'senior'] as const).flatMap((group) =>
  p.examples[group].map((e: { label: string; paragraphs: string[] }) => ({ group, label: e.label, text: e.paragraphs.join(' ') }))
);
const nextHref = hasJobDescription ? `/job-description/${job}/` : '/resume-bullet-points/';
const nextLabel = hasJobDescription ? `${p.name} job description duties` : 'Bullet point generator';
---

<Base title={p.h1} description={p.metaDescription}>
  <BreadcrumbJsonLd items={[
    { name: 'Home', href: '/' },
    { name: 'Resume summaries', href: '/resume-summary/' },
    { name: p.name, href: `/resume-summary/${job}/` },
  ]} />
  <ArticleJsonLd headline={p.h1} description={p.metaDescription} path={`/resume-summary/${job}/`} />
  <AppJsonLd name={`${p.name} resume summary generator`} description={`Free browser tool that writes a ${label} resume summary, objective, or LinkedIn headline.`} path={`/resume-summary/${job}/`} />
  <!-- 1. H1 + 2. Short answer -->
  <section class="prof-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/resume-summary/">Resume summaries</a> <span aria-hidden="true">/</span>
        <span>{p.name}</span>
      </nav>
      <h1>{p.h1}</h1>
      <p class="lead short-answer">{p.shortAnswer}</p>
      <p class="review-line">
        <span><b>20 examples</b> for entry level, mid-career and senior</span>
        <span>Reviewed {SITE.contentLastReviewed.replace(/^(\w{3})\w*/, '$1')} by the SummaryIn editorial team · <a href="/editorial-policy/">How we review</a></span>
      </p>
      {(hasJobDescription || hasNoExperienceGuide) && (
        <p class="pair-links">
          <span class="muted">Not what you need?</span>
          {hasJobDescription && <a href={`/job-description/${job}/`}>Duties for the experience section →</a>}
          {hasNoExperienceGuide && <a href={`/no-experience/${job}/`}>No {label} experience yet →</a>}
        </p>
      )}
    </div>
  </section>

  <!-- 3. Examples with filter and editor -->
  <ExampleLibrary
    name={p.name}
    slug={job as string}
    heading={`${p.name} summary for resume: ${libItems.length} examples`}
    items={libItems}
    groups={[{ key: 'entry', label: 'Entry-level' }, { key: 'mid', label: 'Mid-career' }, { key: 'senior', label: 'Senior' }]}
    start="mid"
    nextHref={nextHref}
    nextLabel={nextLabel}
  />

  <!-- 4. Generator, preset for this profession -->
  <section class="tool-section" id="generator">
    <div class="container">
      <h2 class="block-title">Build a {label} summary from scratch</h2>
      <Generator defaultRole={p.roleDefault} heading="Your details" />
    </div>
  </section>

  <!-- 5. How to adapt + 6. Power words -->
  <section class="section section-subtle" id="power-words" aria-labelledby="adapt-heading">
    <div class="container">
      <div class="grid grid-2">
        <div class="card">
          <h2 id="adapt-heading" class="block-title">How to adapt these to a job posting</h2>
          <ol class="adapt-steps">
            {p.howToAdapt.map((s: { step: string; text: string }) => (
              <li>
                <h3>{s.step}</h3>
                <p class="muted">{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
        <div class="card">
          <h2 class="block-title">Power words for {p.name.toLowerCase()}</h2>
          <div class="table-wrap">
            <table class="data">
              <thead>
                <tr><th scope="col">Word</th><th scope="col">How to use it</th></tr>
              </thead>
              <tbody>
                {p.powerWords.map((w: { word: string; usage: string }) => (
                  <tr><td>{w.word}</td><td>{w.usage}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Reusable visual guide -->
  <SummaryAnatomy profession={p.name} />

  <!-- 8. Related professions -->
  <section class="section" aria-labelledby="rel-heading">
    <div class="container">
      <h2 id="rel-heading" class="block-title">Related profession guides</h2>
      <div class="grid grid-4">
        {related.map((r) =>
          r.live ? (
            <a class="rel-tile card" href={r.href}>{r.name}</a>
          ) : (
            <div class="rel-tile rel-soon card">{r.name} <span class="muted">· soon</span></div>
          )
        )}
      </div>
    </div>
  </section>

  <!-- 9. FAQ -->
  <Faq items={p.faq} heading={`${p.name} summary FAQ`} />

  <!-- 10. Related keywords -->
  <RelatedKeywords keywords={relatedKeywords} />

  <div class="container">
    <EditorialNote label={`${label} resume summary guide`} />
  </div>

  {SITE.emailFormAction && <EmailCapture professionLabel={p.name.toLowerCase()} />}
</Base>

<style>
  .prof-hero { padding: 44px 0 0; }
  .crumbs { font-size: 0.88rem; color: var(--ink-muted); margin-bottom: 16px; }
  .crumbs a { color: var(--ink-muted); }
  .crumbs span[aria-hidden] { margin: 0 4px; }
  .short-answer { max-width: 70ch; }
  .review-line { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 0.9rem; color: var(--ink-muted); margin: 0 0 10px; }
  .review-line b { color: var(--ink); }
  .pair-links { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 0.95rem; margin: 0; }
  .pair-links a { font-weight: 650; }
  .tool-section { padding: 24px 0 40px; }
  .level-group { margin-bottom: 28px; }
  .level-group:last-child { margin-bottom: 0; }
  .level-title {
    font-size: 1.05rem;
    color: var(--ink-soft);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  .block-title { font-size: 1.25rem; margin-bottom: 16px; }
  .adapt-steps { list-style: none; counter-reset: step; margin: 0; padding: 0; }
  .adapt-steps li { counter-increment: step; position: relative; padding-left: 46px; margin-bottom: 18px; }
  .adapt-steps li:last-child { margin-bottom: 0; }
  .adapt-steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 2px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1.6px solid var(--primary);
    color: var(--primary);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
  }
  .adapt-steps h3 { margin-bottom: 2px; font-size: 1rem; }
  .adapt-steps p { margin: 0; font-size: 0.94rem; }
  .rel-tile { padding: 16px 18px; font-weight: 650; color: var(--ink); font-size: 0.97rem; }
  a.rel-tile:hover { text-decoration: none; border-color: var(--primary); box-shadow: var(--shadow-card); }
  .rel-soon { opacity: 0.62; font-weight: 550; }
</style>
