---
/**
 * LinkedIn cluster landing page. Head terms: "linkedin headline generator",
 * "linkedin headline examples", "linkedin about section examples".
 * Uses the shared generator in LinkedIn mode; examples are written, not generated.
 */
import Base from '../../layouts/Base.astro';
import Generator from '../../components/Generator.astro';
import Faq from '../../components/Faq.astro';
import AppJsonLd from '../../components/AppJsonLd.astro';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import EditorialNote from '../../components/EditorialNote.astro';

const description = 'Free LinkedIn headline generator with examples by profession, plus a simple formula and examples for the About section. No sign-up.';

const headlines = [
  { group: 'Healthcare', items: [
    'Registered Nurse | Med-Surg and Telemetry | Patient Education | BLS, ACLS',
    'Certified Nursing Assistant | Long-Term Care | Vital Signs and Mobility Support',
    'Phlebotomist | Venipuncture and Capillary Draws | [X]+ Draws per Shift | Patient-First',
  ] },
  { group: 'Office and business', items: [
    'Administrative Assistant | Calendar and Travel Management | Microsoft 365 | Keeping Teams on Schedule',
    'HR Assistant | Onboarding, HRIS Records, Benefits Support | Aspiring HR Generalist',
    'Staff Accountant | Month-End Close and Reconciliations | QuickBooks, Excel | [X] Years',
  ] },
  { group: 'Retail and hospitality', items: [
    'Customer Service Representative | Phone, Email, Chat Support | [X]% CSAT | Zendesk',
    'Retail Sales Associate | Visual Merchandising | POS and Cash Handling | Open to Keyholder Roles',
    'Bartender | Craft Cocktails and High-Volume Service | TIPS Certified',
  ] },
  { group: 'Logistics and public safety', items: [
    'Warehouse Associate | Picking, Packing, RF Scanning | Forklift Certified',
    'CDL Class A Driver | Regional Routes | Clean MVR | [X]+ Years Accident-Free',
    'Security Officer | Access Control and Patrol | [State] Guard License | Night Shift',
  ] },
];

const about = [
  {
    label: 'Customer service, mid-career',
    text: 'I help customers get answers fast and leave the conversation calmer than they started it. For [X] years I have handled phone, email, and chat support for [industry] companies, most recently resolving [X]+ tickets a day in Zendesk with a [X]% satisfaction score.\n\nWhat I am good at: untangling billing and account problems, writing help articles that cut repeat questions, and training new teammates on tone and tools.\n\nI am looking for a team lead or senior support role where I can coach others and improve the process behind the tickets. Message me here or at [email].',
  },
  {
    label: 'Nursing graduate, first role',
    text: 'New graduate RN starting my career on a [unit type] unit. During [X] clinical hours I cared for up to [X] patients under a preceptor, gave discharge teaching, and charted in Epic.\n\nI chose nursing after [one true sentence about why]. Patients and families tell me I explain things clearly and stay calm when the shift gets busy.\n\nOpen to new graduate residency programs in [city or region]. Licensed in [state], BLS certified.',
  },
];

const faq = [
  {
    q: 'What should I put in my LinkedIn headline?',
    a: 'Start with the job title recruiters search for, then add your specialty, one or two tools or certifications, and a short proof such as a number or the kind of work you want next. Separate the parts with a vertical bar so the line is easy to scan.',
  },
  {
    q: 'How long can a LinkedIn headline be?',
    a: 'LinkedIn allows up to 220 characters. Only the first part shows next to your name in search results and comments, so put the job title and your strongest keyword at the start.',
  },
  {
    q: 'Should my LinkedIn headline match my resume summary?',
    a: 'They should agree but not repeat each other. The headline is a one-line label for search. The resume summary and the LinkedIn About section are short paragraphs that explain your fit in sentences.',
  },
  {
    q: 'What is the difference between the headline and the About section?',
    a: 'The headline is one line under your name. The About section is a longer introduction of up to 2,600 characters. Write it in first person: who you help, what you are good at with one proof, and what role you want next.',
  },
];
---

<Base title="LinkedIn Headline Generator and Examples" description={description}>
  <AppJsonLd name="LinkedIn Headline Generator" description={description} path="/linkedin-headline-generator/" />
  <BreadcrumbJsonLd items={[{ name: 'Home', href: '/' }, { name: 'LinkedIn headline generator', href: '/linkedin-headline-generator/' }]} />

  <section class="hero li-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <span>LinkedIn headline generator</span></nav>
      <h1>LinkedIn Headline Generator</h1>
      <p class="lead">Pick your role and two or three skills, and copy a headline recruiters can find. Examples for the About section are below.</p>
    </div>
  </section>

  <section class="tool-section" id="generator">
    <div class="container">
      <Generator defaultRole="" defaultMode="linkedin" exampleRole="Customer Service Representative" heading="Your details" />
    </div>
  </section>

  <section class="section" aria-labelledby="formula-heading">
    <div class="container">
      <h2 id="formula-heading">A headline formula that works for most jobs</h2>
      <p class="muted li-lead">Recruiters search LinkedIn by job title first, so the title goes at the start. LinkedIn allows 220 characters, but only the first part shows beside your name in search and comments.</p>
      <ol class="li-formula">
        <li><b>Job title</b><span>The exact title recruiters search for</span></li>
        <li><b>Specialty</b><span>The setting, team, or kind of work</span></li>
        <li><b>Tools or credentials</b><span>One or two that the job postings ask for</span></li>
        <li><b>Proof or direction</b><span>A number, or the role you want next</span></li>
      </ol>
    </div>
  </section>

  <section class="section section-subtle" aria-labelledby="headlines-heading">
    <div class="container">
      <h2 id="headlines-heading">LinkedIn headline examples by profession</h2>
      <p class="muted li-lead">Replace each [X] with a true number before you save. Click Copy to take one as a starting point.</p>
      <div class="li-groups">
        {headlines.map((g) => (
          <div class="card li-group">
            <h3>{g.group}</h3>
            <ul>
              {g.items.map((h) => (
                <li>
                  <span class="li-text">{h.split(/(\[[^\]]+\])/g).map((x) => /^\[[^\]]+\]$/.test(x) ? <mark>{x}</mark> : x)}</span>
                  <button type="button" class="btn btn-ghost btn-sm" data-copy-text={h}>Copy</button>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-heading">
    <div class="container">
      <h2 id="about-heading">How to write the LinkedIn About section</h2>
      <p class="muted li-lead">Unlike a resume summary, the About section is written in first person and can run up to 2,600 characters. Three short paragraphs are enough for most people.</p>
      <ol class="li-about-steps">
        <li><b>Who you help and how.</b> One sentence a stranger understands, then your years and setting with one number.</li>
        <li><b>What you are good at.</b> Two or three strengths, each tied to something you did.</li>
        <li><b>What you want next.</b> The role or kind of team you are looking for, and how to reach you.</li>
      </ol>
      <div class="grid grid-2 li-about">
        {about.map((a) => (
          <div class="card">
            <h3>{a.label}</h3>
            {a.text.split('\n\n').map((p) => <p>{p.split(/(\[[^\]]+\])/g).map((x) => /^\[[^\]]+\]$/.test(x) ? <mark>{x}</mark> : x)}</p>)}
            <button type="button" class="btn btn-ghost btn-sm" data-copy-text={a.text}>Copy</button>
          </div>
        ))}
      </div>
      <p class="muted li-next">Need the resume version too? Use the <a href="/#generator">resume summary generator</a>, or <a href="/tailor-resume-summary/">tailor a summary to a job posting</a>.</p>
    </div>
  </section>

  <Faq items={faq} heading="LinkedIn headline FAQ" />
  <div class="container"><EditorialNote label="LinkedIn headline guide" /></div>
</Base>

<style>
  .li-hero { padding-bottom: 0; }
  .crumbs { font-size: 0.88rem; color: var(--ink-muted); margin-bottom: 14px; }
  .crumbs a { color: var(--ink-muted); }
  .li-lead { max-width: 64ch; }
  .li-formula { list-style: none; counter-reset: f; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin: 16px 0 0; padding: 0; }
  @media (max-width: 820px) { .li-formula { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .li-formula li { counter-increment: f; border: 1px solid var(--border); border-radius: var(--r-md); padding: 14px; }
  .li-formula li::before { content: counter(f); display: block; font-size: 1.35rem; font-weight: 800; color: var(--primary); margin-bottom: 4px; }
  .li-formula b { display: block; }
  .li-formula span { font-size: 0.9rem; color: var(--ink-soft); }
  .li-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }
  @media (max-width: 820px) { .li-groups { grid-template-columns: 1fr; } }
  .li-group h3 { font-size: 0.8rem; font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 6px; }
  .li-group ul { list-style: none; margin: 0; padding: 0; }
  .li-group li { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid var(--border); font-size: 0.94rem; }
  .li-group li:first-child { border-top: 0; }
  .li-text { min-width: 0; }
  mark { background: #fff3b8; border-radius: 3px; padding: 0 2px; color: inherit; }
  .li-about-steps { margin: 12px 0 18px; padding-left: 20px; color: var(--ink-soft); }
  .li-about-steps li { margin-bottom: 6px; }
  .li-about h3 { font-size: 1rem; margin: 0 0 8px; }
  .li-about p { font-size: 0.94rem; color: var(--ink-soft); }
  .li-next { margin-top: 16px; }
</style>

<script>
  import { track } from '@vercel/analytics';
  document.querySelectorAll<HTMLButtonElement>('[data-copy-text]').forEach((b) => {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copyText || ''); } catch { /* clipboard unavailable */ }
      b.textContent = 'Copied!';
      setTimeout(() => { b.textContent = 'Copy'; }, 1400);
      track('copy', { tool: 'linkedin_example' });
    });
  });
</script>
