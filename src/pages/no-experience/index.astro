---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import ArticleJsonLd from '../../components/ArticleJsonLd.astro';
import professions from '../../data/professions.json';
import noExperienceExamples from '../../data/noExperienceExamples.json';
import { NO_EXPERIENCE_SLUGS } from '../../data/noExperience';
import { ROLE_GROUPS } from '../../data/roles';
import { SITE } from '../../data/site';

const title = 'Resume Summary With No Experience';
const description = 'Write a resume summary with no experience using training, projects, volunteering, and transferable skills, with examples for 14 professions.';
type Ex = { label: string; paragraphs: string[] };
const P = professions as Record<string, { name: string; examples: { entry: Ex[] } }>;
const OWN = noExperienceExamples as Record<string, { label: string }[]>;
const slugs = NO_EXPERIENCE_SLUGS as readonly string[];
const groups = ROLE_GROUPS.map((g) => ({
  name: g.name,
  pages: g.slugs.filter((s) => slugs.includes(s)).map((slug) => ({
    slug,
    name: P[slug].name,
    labels: (OWN[slug] ?? P[slug].examples.entry).slice(0, 3).map((e) => e.label),
  })),
})).filter((g) => g.pages.length);

const faq = [
  { q: 'Can a resume summary work when I have no experience?', a: 'Yes, if it explains what qualifies you now. Use a target role, relevant training or transferable work, and one specific detail such as a tool, credential, project, workload, or result.' },
  { q: 'Is a resume objective better for a first job?', a: 'An objective focuses on what you want. A summary focuses on what you can already bring. For most applications, two or three lines of relevant evidence are more useful than a sentence saying you want an opportunity. If you still want one, the generator has an Objective tab.' },
  { q: 'What counts as experience besides a paid job?', a: 'Coursework, placements, internships, volunteering, caregiving, military service, student organizations, freelance work, and personal projects can count when they demonstrate work relevant to the role. Label the setting honestly.' },
  { q: 'How long should an entry-level summary be?', a: 'Two or three short sentences are usually enough. Name the target, show the closest relevant preparation, and add one detail that makes the claim concrete.' },
];

const mistakes = [
  ['Opening with an apology', 'I have no experience, but I am eager to learn and grow with your company.', 'Entry-level receptionist with scheduling experience from a university office placement.'],
  ['Copying a sample metric', 'Routed [X]+ calls a day, with the number left exactly as it was in the example.', 'Routed about [your real number] calls a day, or the same line without a number.'],
  ['Personality words without evidence', 'Reliable, motivated, hard-working team player.', 'Completed a [X]-hour placement with a clean attendance record.'],
  ['One summary for every job', 'The same opening sent to a clinic, a hotel, and an office.', 'Same facts, with the most relevant training or tool moved to the front.'],
];
const evidence = [
  ['Placements', 'Clinical rotations, student teaching, internships, apprenticeships.'],
  ['Unpaid work', 'Volunteering, community work, caregiving.'],
  ['Military service', 'Duties, training, and clearances that carry over.'],
  ['Part-time jobs', 'Customers, cash, records, safety, or scheduling.'],
  ['Courses and licenses', 'Projects with the same tools, certificates, required training.'],
];
---

<Base title={title} description={description}>
  <BreadcrumbJsonLd items={[{ name: 'Home', href: '/' }, { name: 'No experience', href: '/no-experience/' }]} />
  <ArticleJsonLd headline={title} description={description} path="/no-experience/" />

  <section class="hub-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <span>No experience</span></nav>
      <h1>How to Write a Resume Summary With No Experience</h1>
      <p class="lead">Start with the role you are prepared for, show where you practiced the skills, and finish with one detail you can explain.</p>
      <p class="review-line">Reviewed {SITE.contentLastReviewed.replace(/^(\w{3})\w*/, '$1')} by the SummaryIn editorial team · <a href="/editorial-policy/">How we review</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="roles-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="roles-heading">First-job examples by profession</h2>
        <p class="muted">Six examples on each page, from graduates to people moving over from another job.</p>
      </div>
      {groups.map((g) => (
        <div class="ne-group">
          <h3 class="ne-group-title">{g.name}</h3>
          <div class="ne-grid">
            {g.pages.map((page) => (
              <a class="ne-card" href={`/no-experience/${page.slug}/`}>
                <span class="ne-top"><b>{page.name}</b><small>6 examples</small></span>
                <ul>{page.labels.map((l) => <li>{l}</li>)}</ul>
                <span class="ne-open">{page.name} with no experience →</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section section-subtle" aria-labelledby="formula-heading">
    <div class="container">
      <h2 id="formula-heading">A three-part structure that stays honest</h2>
      <div class="tri">
        <p class="tri-ex card">
          <span class="a1">Entry-level receptionist</span>
          <span class="a2">with hands-on scheduling and customer support experience from a university office placement</span>.
          <span class="a3">Used Outlook and a multi-line phone system to route [X]+ calls a day</span> while keeping appointment records accurate.
        </p>
        <ol class="tri-list">
          <li><i class="a1"></i><div><b>Target</b>The role, qualification, or career direction.</div></li>
          <li><i class="a2"></i><div><b>Preparation</b>Training, transferable work, a placement, or a relevant project.</div></li>
          <li><i class="a3"></i><div><b>Proof</b>A credential, tool, workload, result, or piece of feedback.</div></li>
        </ol>
      </div>
      <h3 class="ev-title">What counts as experience</h3>
      <div class="ev">
        {evidence.map(([t, d]) => <div class="card"><b>{t}</b>{d}</div>)}
      </div>
      <p class="ev-note"><b>Name the setting honestly.</b> A placement is useful evidence, but it should not be presented as a paid job.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="mistakes-heading">
    <div class="container">
      <h2 id="mistakes-heading">Four mistakes that weaken a first summary</h2>
      <div class="mis">
        {mistakes.map(([t, weak, better]) => (
          <div class="mis-card">
            <h3>{t}</h3>
            <div class="mis-row">
              <div class="mis-weak"><small>Weak</small>{weak}</div>
              <div class="mis-better"><small>Better</small>{better}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Faq items={faq} heading="No-experience resume summary FAQ" />

  <section class="section">
    <div class="container">
      <div class="ne-cta">
        <div><h2>Your role is not on the list?</h2><p>Type any job title into the generator and pick Entry level. It works in your browser, no sign-up.</p></div>
        <a class="btn btn-primary" href="/#generator">Open the generator</a>
      </div>
      <p class="ne-more muted">Already have a year or more in the role? See <a href="/resume-summary/">mid-career and senior examples by profession →</a></p>
    </div>
  </section>
</Base>

<style>
  .hub-hero { padding: 40px 0 0; }
  .crumbs { font-size: 0.88rem; color: var(--ink-muted); margin-bottom: 14px; }
  .crumbs a { color: var(--ink-muted); }
  .hub-hero .lead { max-width: 40rem; }
  .review-line { font-size: 0.9rem; color: var(--ink-muted); margin: 0; }
  .ne-group { margin-top: 24px; }
  .ne-group-title { font-size: 0.8rem; font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 10px; }
  .ne-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 900px) { .ne-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .ne-grid { grid-template-columns: 1fr; } }
  .ne-card { border: 1px solid var(--border); border-radius: var(--r-lg); padding: 16px; display: flex; flex-direction: column; gap: 8px; color: var(--ink); background: #fff; }
  .ne-card:hover { text-decoration: none; border-color: var(--primary-border); }
  .ne-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .ne-top b { font-size: 1.02rem; }
  .ne-top small { font-size: 0.8rem; color: var(--ink-muted); }
  .ne-card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; font-size: 0.9rem; color: var(--ink-soft); }
  .ne-card li::before { content: "→ "; color: var(--ink-muted); }
  .ne-open { margin-top: auto; padding-top: 4px; font-size: 0.88rem; font-weight: 650; color: var(--primary); }
  .tri { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 28px; align-items: start; margin-top: 16px; }
  @media (max-width: 820px) { .tri { grid-template-columns: 1fr; } }
  .tri-ex { margin: 0; font-size: 1.05rem; line-height: 1.75; }
  .tri-ex span { border-radius: 4px; padding: 1px 3px; }
  .a1 { background: #dbeafe; } .a2 { background: #dcfce7; } .a3 { background: #fef3c7; }
  .tri-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .tri-list li { display: grid; grid-template-columns: 14px 1fr; gap: 12px; font-size: 0.97rem; color: var(--ink-soft); }
  .tri-list i { width: 14px; height: 14px; border-radius: 4px; margin-top: 5px; }
  .tri-list b { display: block; color: var(--ink); }
  .ev-title { margin-top: 32px; font-size: 1.1rem; }
  .ev { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 900px) { .ev { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .ev .card { padding: 14px; font-size: 0.92rem; color: var(--ink-soft); }
  .ev b { display: block; color: var(--ink); margin-bottom: 4px; }
  .ev-note { margin: 14px 0 0; border-left: 3px solid #fde68a; padding: 4px 0 4px 12px; color: var(--ink-soft); }
  .ev-note b { color: var(--ink); }
  .mis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 16px; }
  @media (max-width: 820px) { .mis { grid-template-columns: 1fr; } }
  .mis-card { border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden; }
  .mis-card h3 { padding: 12px 16px 0; font-size: 1rem; margin: 0; }
  .mis-row { display: grid; grid-template-columns: 1fr 1fr; margin-top: 10px; border-top: 1px solid var(--border); }
  @media (max-width: 600px) { .mis-row { grid-template-columns: 1fr; } }
  .mis-row div { padding: 10px 16px; font-size: 0.92rem; line-height: 1.5; }
  .mis-weak { background: #fef2f2; color: #7f1d1d; }
  .mis-better { background: var(--success-soft); color: #14532d; }
  .mis-row small { display: block; font-size: 0.7rem; font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 3px; opacity: 0.75; }
  .ne-cta { background: var(--ink); color: #cbd5e1; border-radius: var(--r-lg); padding: 26px 30px; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .ne-cta h2 { color: #fff; font-size: 1.4rem; margin: 0 0 4px; }
  .ne-cta p { margin: 0; }
  .ne-more { margin: 18px 0 0; font-size: 0.95rem; }
</style>
